<UserControl x:Class="Foundry.App.Views.ShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Foundry.App.Controls">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="212"/>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="360"/>
    </Grid.ColumnDefinitions>

    <!-- ===================== RAIL ===================== -->
    <Border Grid.Column="0" Background="{StaticResource Brush.Surface0}" BorderBrush="{StaticResource Brush.Hairline}" BorderThickness="0,0,1,0">
      <DockPanel>
        <!-- header -->
        <StackPanel DockPanel.Dock="Top" Margin="14,16,14,12">
          <Button HorizontalAlignment="Left" Command="{Binding BackCommand}" Cursor="Hand"
                  Background="Transparent" BorderThickness="0" Padding="0">
            <StackPanel Orientation="Horizontal">
              <c:IconControl Glyph="chev" IconSize="10" Stroke="{StaticResource Brush.InkMute}"/>
              <TextBlock Style="{StaticResource Kicker}" Margin="6,0,0,0" Text="ALL PROJECTS"/>
            </StackPanel>
          </Button>
          <TextBlock Style="{StaticResource Serif}" FontSize="22" Margin="0,8,0,0" TextWrapping="Wrap" Text="{Binding Project.Title}"/>
          <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <TextBlock Style="{StaticResource Kicker}" FontSize="10" Text="{Binding Project.Id}"/>
            <TextBlock Style="{StaticResource Kicker}" FontSize="10" Margin="10,0,0,0" Foreground="{DynamicResource Brush.Accent}" Text="{Binding Project.Status, StringFormat='● {0}'}"/>
          </StackPanel>
        </StackPanel>

        <!-- footer -->
        <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Brush.Hairline}" BorderThickness="0,1,0,0" Padding="14,10">
          <Grid>
            <TextBlock Style="{StaticResource Kicker}" FontSize="10" Text="Saved · auto"/>
            <TextBlock Style="{StaticResource Kicker}" FontSize="10" HorizontalAlignment="Right" Text="14:21"/>
          </Grid>
        </Border>

        <!-- nav -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" BorderBrush="{StaticResource Brush.Hairline}" BorderThickness="0,1,0,0">
          <StackPanel Margin="0,12">
            <TextBlock Style="{StaticResource Kicker}" FontSize="9.5" Foreground="{StaticResource Brush.InkFaint}" Margin="14,12,14,6" Text="DESIGN"/>
            <ListBox ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab, Mode=TwoWay}"
                     Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch">
              <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                  <Setter Property="Padding" Value="0"/>
                  <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" Padding="14,9" BorderThickness="2,0,0,0" BorderBrush="Transparent">
                          <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource Brush.Surface1}"/>
                          </Trigger>
                          <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource Brush.Surface1}"/>
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                </Style>
              </ListBox.ItemContainerStyle>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="22"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource Mono}" FontSize="10" Foreground="{StaticResource Brush.InkFaint}" Text="{Binding Number}"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                      <c:IconControl Glyph="{Binding Icon}" IconSize="13" Stroke="{StaticResource Brush.InkSoft}" Margin="0,0,10,0"/>
                      <TextBlock Style="{StaticResource Mono}" FontSize="12" Text="{Binding Label}"/>
                    </StackPanel>
                    <Border Grid.Column="2" Background="{StaticResource Brush.TagWarnBg}" Padding="5,1" Visibility="{Binding HasBadge, Converter={StaticResource BoolVis}}">
                      <TextBlock Style="{StaticResource Mono}" FontSize="9" Foreground="{StaticResource Brush.Warn}" Text="{Binding BadgeText}"/>
                    </Border>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Style="{StaticResource Kicker}" FontSize="9.5" Foreground="{StaticResource Brush.InkFaint}" Margin="14,12,14,6" Text="STAGES"/>
            <ItemsControl ItemsSource="{Binding Stages}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="14,5">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource Mono}" FontSize="10" Foreground="{StaticResource Brush.InkFaint}" Text="{Binding N}"/>
                    <TextBlock Grid.Column="1" Style="{StaticResource Mono}" FontSize="11" Text="{Binding Name}"/>
                    <TextBlock Grid.Column="2" Style="{StaticResource Mono}" FontSize="9" Foreground="{StaticResource Brush.Ok}" Text="✓"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- ===================== MAIN ===================== -->
    <Border Grid.Column="1" Background="{StaticResource Brush.Bg}">
      <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource Brush.Surface0}" BorderBrush="{StaticResource Brush.Hairline}" BorderThickness="0,0,0,1" Height="38">
          <Grid>
            <Border BorderBrush="{StaticResource Brush.Hairline}" BorderThickness="0,0,1,0" HorizontalAlignment="Left">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0">
                <TextBlock Style="{StaticResource Kicker}" Text="{Binding Project.Title}"/>
                <TextBlock Style="{StaticResource Kicker}" Margin="10,0" Foreground="{StaticResource Brush.Hairline3}" Text="/"/>
                <TextBlock Style="{StaticResource Kicker}" Foreground="{StaticResource Brush.Ink}" Text="{Binding SelectedTab.Label}"/>
              </StackPanel>
            </Border>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <Button Style="{StaticResource Btn}" BorderThickness="1,0,0,0" Padding="14,0" Background="Transparent">
                <StackPanel Orientation="Horizontal"><c:IconControl Glyph="eye" IconSize="11" Margin="0,0,8,0"/><TextBlock Text="PREVIEW"/></StackPanel>
              </Button>
              <Button Style="{StaticResource Btn}" BorderThickness="1,0,0,0" Padding="14,0" Background="Transparent">
                <StackPanel Orientation="Horizontal"><c:IconControl Glyph="download" IconSize="11" Margin="0,0,8,0"/><TextBlock Text="EXPORT"/></StackPanel>
              </Button>
              <Button Style="{StaticResource Btn}" BorderThickness="1,0,0,0" Padding="14,0" Background="Transparent">
                <c:IconControl Glyph="settings" IconSize="11"/>
              </Button>
            </StackPanel>
          </Grid>
        </Border>
        <ContentControl Content="{Binding CurrentTabView}"/>
      </DockPanel>
    </Border>

    <!-- ===================== CHAT ===================== -->
    <Border Grid.Column="2" Background="{StaticResource Brush.Surface0}" BorderBrush="{StaticResource Brush.Hairline}" BorderThickness="1,0,0,0">
      <DockPanel>
        <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Brush.Hairline}" BorderThickness="0,0,0,1" Padding="16,12">
          <Grid>
            <TextBlock Style="{StaticResource Kicker}" Foreground="{StaticResource Brush.InkSoft}" Text="ITERATION · CHAT"/>
            <TextBlock Style="{StaticResource Kicker}" HorizontalAlignment="Right" Text="turn 3"/>
          </Grid>
        </Border>

        <!-- composer -->
        <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Brush.Hairline}" BorderThickness="0,1,0,0" Padding="12">
          <StackPanel>
            <TextBox Style="{StaticResource FieldInput}" MinHeight="70" TextWrapping="Wrap" AcceptsReturn="True"
                     Background="{StaticResource Brush.Surface1}" BorderBrush="{StaticResource Brush.Hairline2}"
                     Text="{Binding ChatInput, UpdateSourceTrigger=PropertyChanged}"
                     Tag="Iterate by chat — 'make it solar powered', 'shrink the enclosure 10%', 'swap to STM32'…"/>
            <Grid Margin="0,10,0,0">
              <TextBlock Style="{StaticResource Kicker}" FontSize="10" VerticalAlignment="Center" Text="↩ to send · ⇧↩ newline"/>
              <Button HorizontalAlignment="Right" Style="{StaticResource BtnPrimary}" Padding="12,6" FontSize="10" Command="{Binding SendCommand}">
                <StackPanel Orientation="Horizontal"><c:IconControl Glyph="send" IconSize="11" Stroke="{StaticResource Brush.OnAccent}" Margin="0,0,6,0"/><TextBlock Text="SEND"/></StackPanel>
              </Button>
            </Grid>
          </StackPanel>
        </Border>

        <!-- message list -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="16,14">
            <ItemsControl ItemsSource="{Binding Chat}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                      <TextBlock Style="{StaticResource Kicker}" FontSize="10" Text="{Binding Role}"/>
                      <TextBlock Style="{StaticResource Kicker}" FontSize="10" Margin="8,0,0,0" Foreground="{StaticResource Brush.InkFaint}" Text="{Binding Time, StringFormat='· {0}'}"/>
                    </StackPanel>
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Brush.InkSoft}" FontFamily="{StaticResource Font.Mono}" FontSize="12.5" LineHeight="19" Text="{Binding Text}"/>
                    <ItemsControl ItemsSource="{Binding Pipeline}" Margin="0,10,0,0"
                                  Visibility="{Binding Pipeline, Converter={StaticResource NullVis}}">
                      <ItemsControl.Template>
                        <ControlTemplate TargetType="ItemsControl">
                          <Border Background="{StaticResource Brush.Surface1}" BorderBrush="{StaticResource Brush.Hairline2}" BorderThickness="1" Padding="10,8">
                            <ItemsPresenter/>
                          </Border>
                        </ControlTemplate>
                      </ItemsControl.Template>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Grid Margin="0,2">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource Mono}" FontSize="10.5" Foreground="{StaticResource Brush.Ok}" Text="✓"/>
                            <TextBlock Grid.Column="1" Style="{StaticResource Mono}" FontSize="10.5" Foreground="{StaticResource Brush.InkMute}" Text="{Binding Stage}"/>
                            <TextBlock Grid.Column="2" Style="{StaticResource Mono}" FontSize="9.5" Foreground="{StaticResource Brush.InkFaint}" Text="{Binding State}"/>
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- live pipeline while generating -->
            <Border Background="{StaticResource Brush.Surface1}" BorderBrush="{StaticResource Brush.Hairline2}" BorderThickness="1" Padding="10,8"
                    Visibility="{Binding IsGenerating, Converter={StaticResource BoolVis}}">
              <ItemsControl ItemsSource="{Binding LivePipeline}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,2">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <TextBlock Grid.Column="0" Style="{StaticResource Mono}" FontSize="10.5" Foreground="{StaticResource Brush.InkMute}" Text="{Binding Stage}"/>
                      <TextBlock Grid.Column="1" Style="{StaticResource Mono}" FontSize="9.5" Foreground="{DynamicResource Brush.Accent}" Text="{Binding State}"/>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
