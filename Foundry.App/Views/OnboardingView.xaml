<UserControl x:Class="Foundry.App.Views.OnboardingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Foundry.App.Controls">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="1.15*"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- LEFT — display -->
    <Border Grid.Column="0" BorderBrush="{StaticResource Brush.Hairline}" BorderThickness="0,0,1,0" Padding="56,56,56,32">
      <Border.Background>
        <RadialGradientBrush Center="0.8,1.1" GradientOrigin="0.8,1.1" RadiusX="0.6" RadiusY="0.6">
          <GradientStop Color="#4DFF5A1F" Offset="0"/><GradientStop Color="#00000000" Offset="0.6"/>
        </RadialGradientBrush>
      </Border.Background>
      <DockPanel>
        <StackPanel DockPanel.Dock="Top">
          <TextBlock Style="{StaticResource Kicker}" Text="FOUNDRY · 0.4.1 · Windows 11 · Local-first"/>
          <TextBlock Style="{StaticResource Serif}" FontSize="120" LineHeight="124" Margin="0,36,0,0">
            <Run Text="Prompt."/><LineBreak/>
            <Run Text="Wire." Foreground="{DynamicResource Brush.Accent}" FontStyle="Italic"/><LineBreak/>
            <Run Text="Print."/>
          </TextBlock>
          <TextBlock Style="{StaticResource Serif}" FontSize="22" Foreground="{StaticResource Brush.InkFaint}" Margin="0,14,0,0"
                     Text="— one prompt → a buildable device."/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" MaxWidth="460" HorizontalAlignment="Left">
          <TextBlock Style="{StaticResource KickerAccent}" Text="Pipeline ▸" Margin="0,0,0,12"/>
          <Border BorderBrush="{StaticResource Brush.Hairline2}" BorderThickness="1">
            <UniformGrid Columns="7">
              <Border Background="{StaticResource Brush.TagAccentBg}" BorderBrush="{StaticResource Brush.Hairline}" BorderThickness="0,0,1,0" Padding="8,10"><TextBlock Style="{StaticResource Kicker}" FontSize="9.5" Foreground="{DynamicResource Brush.Accent}" TextAlignment="Center" Text="01&#x0a;Spec"/></Border>
              <Border BorderBrush="{StaticResource Brush.Hairline}" BorderThickness="0,0,1,0" Padding="8,10"><TextBlock Style="{StaticResource Kicker}" FontSize="9.5" Foreground="{StaticResource Brush.InkSoft}" TextAlignment="Center" Text="02&#x0a;Arch"/></Border>
              <Border BorderBrush="{StaticResource Brush.Hairline}" BorderThickness="0,0,1,0" Padding="8,10"><TextBlock Style="{StaticResource Kicker}" FontSize="9.5" Foreground="{StaticResource Brush.InkSoft}" TextAlignment="Center" Text="03&#x0a;BOM"/></Border>
              <Border BorderBrush="{StaticResource Brush.Hairline}" BorderThickness="0,0,1,0" Padding="8,10"><TextBlock Style="{StaticResource Kicker}" FontSize="9.5" Foreground="{StaticResource Brush.InkSoft}" TextAlignment="Center" Text="04&#x0a;Wiring"/></Border>
              <Border BorderBrush="{StaticResource Brush.Hairline}" BorderThickness="0,0,1,0" Padding="8,10"><TextBlock Style="{StaticResource Kicker}" FontSize="9.5" Foreground="{StaticResource Brush.InkSoft}" TextAlignment="Center" Text="05&#x0a;Firmware"/></Border>
              <Border BorderBrush="{StaticResource Brush.Hairline}" BorderThickness="0,0,1,0" Padding="8,10"><TextBlock Style="{StaticResource Kicker}" FontSize="9.5" Foreground="{StaticResource Brush.InkSoft}" TextAlignment="Center" Text="06&#x0a;CAD"/></Border>
              <Border Padding="8,10"><TextBlock Style="{StaticResource Kicker}" FontSize="9.5" Foreground="{StaticResource Brush.InkSoft}" TextAlignment="Center" Text="07&#x0a;Validate"/></Border>
            </UniformGrid>
          </Border>
          <TextBlock FontFamily="{StaticResource Font.Mono}" FontSize="11.5" Foreground="{StaticResource Brush.InkMute}" TextWrapping="Wrap" LineHeight="18" Margin="0,16,0,0"
                     Text="Architecture, BOM, wiring diagram, starter firmware, a printable enclosure, and rule-based electrical validation — re-runnable per stage as you iterate by chat."/>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- RIGHT — form -->
    <Border Grid.Column="1" Background="{StaticResource Brush.Bg}" Padding="56,56,56,32">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top">
          <TextBlock Style="{StaticResource Kicker}" Text="Setup · Step 1 of 2"/>
          <TextBlock Style="{StaticResource Serif}" FontSize="38" Margin="0,8,0,0" Text="API keys"/>
          <TextBlock Foreground="{StaticResource Brush.InkMute}" FontFamily="{StaticResource Font.Mono}" FontSize="12" TextWrapping="Wrap" MaxWidth="420" Margin="0,8,0,0"
                     Text="Keys are stored in Windows Credential Manager (DPAPI-backed). They never touch Project files or logs. The app falls back to 'offline' states when keys are missing."/>

          <!-- tabs -->
          <Border BorderBrush="{StaticResource Brush.Hairline}" BorderThickness="0,0,0,1" Margin="0,16,0,0">
            <StackPanel Orientation="Horizontal">
              <Button Command="{Binding SelectTabCommand}" CommandParameter="anthropic" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="0">
                <Border Padding="18,12" BorderThickness="0,0,0,2"
                        BorderBrush="{Binding ActiveTab, Converter={StaticResource ActiveTabBrush}, ConverterParameter=anthropic}">
                  <TextBlock Style="{StaticResource Kicker}" Foreground="{Binding ActiveTab, Converter={StaticResource ActiveTabInk}, ConverterParameter=anthropic}" Text="ANTHROPIC · required"/>
                </Border>
              </Button>
              <Button Command="{Binding SelectTabCommand}" CommandParameter="sourcing" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="0">
                <Border Padding="18,12" BorderThickness="0,0,0,2"
                        BorderBrush="{Binding ActiveTab, Converter={StaticResource ActiveTabBrush}, ConverterParameter=sourcing}">
                  <TextBlock Style="{StaticResource Kicker}" Foreground="{Binding ActiveTab, Converter={StaticResource ActiveTabInk}, ConverterParameter=sourcing}" Text="SOURCING · optional"/>
                </Border>
              </Button>
            </StackPanel>
          </Border>

          <!-- anthropic tab -->
          <StackPanel Margin="0,22,0,0" Visibility="{Binding IsAnthropicTab, Converter={StaticResource BoolVis}}">
            <StackPanel>
              <Grid Margin="0,0,0,8">
                <TextBlock Style="{StaticResource Kicker}" Foreground="{StaticResource Brush.InkSoft}" Text="ANTHROPIC API KEY"/>
                <TextBlock Style="{StaticResource KickerAccent}" HorizontalAlignment="Right" Text="required"/>
              </Grid>
              <TextBox Style="{StaticResource FieldInput}" Text="{Binding AnthropicKey, UpdateSourceTrigger=PropertyChanged}"/>
              <TextBlock Foreground="{StaticResource Brush.InkMute}" FontFamily="{StaticResource Font.Mono}" FontSize="10.5" TextWrapping="Wrap" Margin="0,8,0,0"
                         Text="Used for the staged generation pipeline. Generation uses claude-opus-5; chat edits use claude-sonnet-5."/>
            </StackPanel>
            <Grid Margin="0,12,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border Grid.Column="0" Style="{StaticResource Card}" Padding="14" Margin="0,0,6,0">
                <StackPanel><TextBlock Style="{StaticResource Kicker}" Text="Default model"/><TextBlock Style="{StaticResource Serif}" FontSize="22" Margin="0,4,0,0" Text="Sonnet 5"/><TextBlock Style="{StaticResource Mono}" FontSize="11" Foreground="{StaticResource Brush.InkMute}" Margin="0,4,0,0" Text="Balanced. ~$0.04 / project."/></StackPanel>
              </Border>
              <Border Grid.Column="1" Style="{StaticResource Card}" Padding="14" Margin="6,0,0,0">
                <StackPanel><TextBlock Style="{StaticResource Kicker}" Text="Hard mode"/><TextBlock Style="{StaticResource Serif}" FontSize="22" Margin="0,4,0,0" Text="Opus 5"/><TextBlock Style="{StaticResource Mono}" FontSize="11" Foreground="{StaticResource Brush.InkMute}" Margin="0,4,0,0" Text="For complex designs. ~$0.40."/></StackPanel>
              </Border>
            </Grid>
          </StackPanel>

          <!-- sourcing tab -->
          <StackPanel Margin="0,22,0,0" Visibility="{Binding IsSourcingTab, Converter={StaticResource BoolVis}}">
            <StackPanel>
              <Grid Margin="0,0,0,8">
                <TextBlock Style="{StaticResource Kicker}" Foreground="{StaticResource Brush.InkSoft}" Text="NEXAR / OCTOPART"/>
                <TextBlock Style="{StaticResource Kicker}" Foreground="{StaticResource Brush.InkFaint}" HorizontalAlignment="Right" Text="optional · aggregated stock + pricing"/>
              </Grid>
              <TextBox Style="{StaticResource FieldInput}" Text="{Binding NexarKey, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <Grid Margin="0,12,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Margin="0,0,6,0">
                <TextBlock Style="{StaticResource Kicker}" Foreground="{StaticResource Brush.InkSoft}" Margin="0,0,0,8" Text="DIGIKEY"/>
                <TextBox Style="{StaticResource FieldInput}" Text="{Binding DigiKeyKey, UpdateSourceTrigger=PropertyChanged}"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Margin="6,0,0,0">
                <TextBlock Style="{StaticResource Kicker}" Foreground="{StaticResource Brush.InkSoft}" Margin="0,0,0,8" Text="MOUSER"/>
                <TextBox Style="{StaticResource FieldInput}" Text="{Binding MouserKey, UpdateSourceTrigger=PropertyChanged}"/>
              </StackPanel>
            </Grid>
          </StackPanel>
        </StackPanel>

        <!-- footer -->
        <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Brush.Hairline}" BorderThickness="0,1,0,0" Padding="0,24,0,0">
          <Grid>
            <Button Style="{StaticResource BtnGhost}" HorizontalAlignment="Left" Command="{Binding SkipCommand}" Content="Skip · explore demo"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <TextBlock VerticalAlignment="Center" Margin="0,0,12,0" FontFamily="{StaticResource Font.Mono}" FontSize="11" Foreground="{StaticResource Brush.InkMute}" Text="{Binding TestResult}"/>
              <Button Style="{StaticResource Btn}" Margin="0,0,8,0" Command="{Binding TestConnectionCommand}" Content="Test connection"/>
              <Button Style="{StaticResource BtnPrimary}" Command="{Binding ContinueCommand}">
                <StackPanel Orientation="Horizontal"><TextBlock Text="Continue" Margin="0,0,8,0"/><c:IconControl Glyph="chev" IconSize="12" Stroke="{StaticResource Brush.OnAccent}"/></StackPanel>
              </Button>
            </StackPanel>
          </Grid>
        </Border>
        <Grid/>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
