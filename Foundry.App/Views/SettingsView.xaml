<UserControl x:Class="Foundry.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Foundry.App.Controls">
  <Border Background="{StaticResource Brush.Bg}">
    <DockPanel>
      <!-- top bar -->
      <Border DockPanel.Dock="Top" Background="{StaticResource Brush.Surface0}" BorderBrush="{StaticResource Brush.Hairline}" BorderThickness="0,0,0,1" Height="38">
        <Grid>
          <Button HorizontalAlignment="Left" Command="{Binding BackCommand}" Background="Transparent" BorderThickness="0,0,1,0"
                  BorderBrush="{StaticResource Brush.Hairline}" Padding="18,0" Cursor="Hand">
            <StackPanel Orientation="Horizontal">
              <c:IconControl Glyph="chev" IconSize="10" Stroke="{StaticResource Brush.InkMute}"/>
              <TextBlock Style="{StaticResource Kicker}" Margin="6,0,0,0" Text="BACK TO WORKSPACE"/>
            </StackPanel>
          </Button>
          <TextBlock Style="{StaticResource Kicker}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Brush.Ink}" Text="SETTINGS"/>
        </Grid>
      </Border>

      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="780" HorizontalAlignment="Center" Margin="32,28,32,60">
          <TextBlock Style="{StaticResource Kicker}" Text="CONFIGURATION · §8.9"/>
          <TextBlock Style="{StaticResource PageH1}" FontSize="56" LineHeight="64" Margin="0,8,0,0">
            <Run Text="Set "/><Run Text="up." Foreground="{DynamicResource Brush.Accent}"/>
          </TextBlock>

          <!-- CLAUDE -->
          <Border Style="{StaticResource Card}" Margin="0,24,0,0">
            <StackPanel>
              <TextBlock Style="{StaticResource Serif}" FontSize="24" Text="Claude"/>
              <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <Grid Margin="0,0,0,8">
                    <TextBlock Style="{StaticResource Kicker}" Foreground="{StaticResource Brush.InkSoft}" Text="ANTHROPIC API KEY"/>
                    <TextBlock Style="{StaticResource Kicker}" HorizontalAlignment="Right" Text="{Binding AnthropicSummary, StringFormat='stored: {0}'}"/>
                  </Grid>
                  <TextBox Style="{StaticResource FieldInput}" Text="{Binding AnthropicKeyInput, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="12,0,0,0">
                  <Button Style="{StaticResource Btn}" Margin="0,0,8,0" Command="{Binding SaveAnthropicKeyCommand}" Content="SAVE"/>
                  <Button Style="{StaticResource BtnGhost}" Command="{Binding RemoveAnthropicKeyCommand}" Content="REMOVE"/>
                </StackPanel>
              </Grid>
              <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <Button Style="{StaticResource Btn}" Command="{Binding TestConnectionCommand}" Content="TEST CONNECTION"/>
                <TextBlock VerticalAlignment="Center" Margin="12,0,0,0" FontFamily="{StaticResource Font.Mono}" FontSize="11" Foreground="{StaticResource Brush.InkMute}" Text="{Binding TestResult}"/>
              </StackPanel>

              <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                  <Grid Margin="0,0,0,8">
                    <TextBlock Style="{StaticResource Kicker}" Foreground="{StaticResource Brush.InkSoft}" Text="DEFAULT MODEL"/>
                    <TextBlock Style="{StaticResource Kicker}" HorizontalAlignment="Right" Text="{Binding ModelSource}"/>
                  </Grid>
                  <ComboBox Style="{StaticResource Combo}" ItemsSource="{Binding Models}"
                            SelectedValue="{Binding SelectedModelId, Mode=TwoWay}" SelectedValuePath="Id">
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <StackPanel>
                          <TextBlock FontFamily="{StaticResource Font.Mono}" FontSize="12" Foreground="{StaticResource Brush.Ink}" Text="{Binding DisplayName}"/>
                          <TextBlock FontFamily="{StaticResource Font.Mono}" FontSize="10" Foreground="{StaticResource Brush.InkMute}" Text="{Binding Id}"/>
                        </StackPanel>
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="1">
                  <TextBlock Style="{StaticResource Kicker}" Foreground="{StaticResource Brush.InkSoft}" Margin="0,0,0,8" Text="MAX OUTPUT TOKENS"/>
                  <TextBox Style="{StaticResource FieldInput}" Text="{Binding MaxOutputTokens}"/>
                </StackPanel>
              </Grid>

              <StackPanel Margin="0,18,0,0">
                <TextBlock Style="{StaticResource Kicker}" Foreground="{StaticResource Brush.InkSoft}" Margin="0,0,0,8" Text="CHAT / EDIT MODEL"/>
                <ComboBox Style="{StaticResource Combo}" ItemsSource="{Binding Models}"
                          SelectedValue="{Binding ChatModelId, Mode=TwoWay}" SelectedValuePath="Id">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <StackPanel>
                        <TextBlock FontFamily="{StaticResource Font.Mono}" FontSize="12" Foreground="{StaticResource Brush.Ink}" Text="{Binding DisplayName}"/>
                        <TextBlock FontFamily="{StaticResource Font.Mono}" FontSize="10" Foreground="{StaticResource Brush.InkMute}" Text="{Binding Id}"/>
                      </StackPanel>
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Style="{StaticResource Mono}" FontSize="10.5" Foreground="{StaticResource Brush.InkMute}" TextWrapping="Wrap" Margin="0,8,0,0"
                           Text="Used for chat iteration &amp; validation fixes — pick a faster model (Sonnet/Haiku) for snappier edits."/>
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- GENERATION + EXPORT -->
          <Border Style="{StaticResource Card}" Margin="0,18,0,0">
            <StackPanel>
              <TextBlock Style="{StaticResource Serif}" FontSize="24" Text="Generation &amp; export"/>
              <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                  <TextBlock Style="{StaticResource Kicker}" Foreground="{StaticResource Brush.InkSoft}" Margin="0,0,0,8" Text="DEFAULT FIRMWARE PLATFORM"/>
                  <ComboBox Style="{StaticResource Combo}" ItemsSource="{Binding FirmwarePlatforms}" SelectedItem="{Binding FirmwarePlatform, Mode=TwoWay}"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                  <TextBlock Style="{StaticResource Kicker}" Foreground="{StaticResource Brush.InkSoft}" Margin="0,0,0,8" Text="ENCLOSURE FORMAT"/>
                  <ComboBox Style="{StaticResource Combo}" ItemsSource="{Binding EnclosureFormats}" SelectedItem="{Binding EnclosureFormat, Mode=TwoWay}"/>
                </StackPanel>
              </Grid>
              <TextBlock Style="{StaticResource Kicker}" Foreground="{StaticResource Brush.InkSoft}" Margin="0,16,0,8" Text="DEFAULT EXPORT FOLDER"/>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Style="{StaticResource FieldInput}" Text="{Binding OutputFolder}"/>
                <Button Grid.Column="1" Style="{StaticResource Btn}" Margin="8,0,0,0" Command="{Binding BrowseFolderCommand}" Content="BROWSE"/>
              </Grid>
            </StackPanel>
          </Border>

          <!-- SOURCING -->
          <Border Style="{StaticResource Card}" Margin="0,18,0,0">
            <StackPanel>
              <Grid>
                <TextBlock Style="{StaticResource Serif}" FontSize="24" Text="Sourcing keys"/>
                <TextBlock Style="{StaticResource Kicker}" HorizontalAlignment="Right" VerticalAlignment="Center" Text="optional · live pricing"/>
              </Grid>

              <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <Grid Margin="0,0,0,8">
                    <TextBlock Style="{StaticResource Kicker}" Foreground="{StaticResource Brush.InkSoft}" Text="NEXAR / OCTOPART  (client_id:client_secret)"/>
                    <TextBlock Style="{StaticResource Kicker}" HorizontalAlignment="Right" Text="{Binding NexarSummary, StringFormat='stored: {0}'}"/>
                  </Grid>
                  <TextBox Style="{StaticResource FieldInput}" Text="{Binding NexarKeyInput, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="12,0,0,0">
                  <Button Style="{StaticResource Btn}" Margin="0,0,8,0" Command="{Binding SaveNexarKeyCommand}" Content="SAVE"/>
                  <Button Style="{StaticResource BtnGhost}" Command="{Binding RemoveNexarKeyCommand}" Content="REMOVE"/>
                </StackPanel>
              </Grid>

              <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                  <TextBlock Style="{StaticResource Kicker}" Foreground="{StaticResource Brush.InkSoft}" Margin="0,0,0,8" Text="{Binding DigiKeySummary, StringFormat='DIGIKEY · {0}'}"/>
                  <TextBox Style="{StaticResource FieldInput}" Text="{Binding DigiKeyInput, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,16,0">
                  <Button Style="{StaticResource Btn}" Margin="0,0,6,0" Command="{Binding SaveDigiKeyCommand}" Content="SAVE"/>
                  <Button Style="{StaticResource BtnGhost}" Command="{Binding RemoveDigiKeyCommand}" Content="✕"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,8,0">
                  <TextBlock Style="{StaticResource Kicker}" Foreground="{StaticResource Brush.InkSoft}" Margin="0,0,0,8" Text="{Binding MouserSummary, StringFormat='MOUSER · {0}'}"/>
                  <TextBox Style="{StaticResource FieldInput}" Text="{Binding MouserKeyInput, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Bottom">
                  <Button Style="{StaticResource Btn}" Margin="0,0,6,0" Command="{Binding SaveMouserKeyCommand}" Content="SAVE"/>
                  <Button Style="{StaticResource BtnGhost}" Command="{Binding RemoveMouserKeyCommand}" Content="✕"/>
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>

          <!-- BOARD HOUSE (FAB ORDER · v2.7) -->
          <Border Style="{StaticResource Card}" Margin="0,18,0,0">
            <StackPanel>
              <Grid>
                <TextBlock Style="{StaticResource Serif}" FontSize="24" Text="Board house keys"/>
                <TextBlock Style="{StaticResource Kicker}" HorizontalAlignment="Right" VerticalAlignment="Center" Text="optional · live PCB quotes"/>
              </Grid>
              <TextBlock Style="{StaticResource Mono}" FontSize="10.5" Foreground="{StaticResource Brush.InkMute}" TextWrapping="Wrap" Margin="0,8,0,0"
                         Text="Keys unlock live PCB quotes and a pre-filled order on the Wiring tab's ORDER PCB step. Foundry never submits or pays — you always finish the order on the fab's own site. Without a key you still get an estimate + assisted handoff."/>
              <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                  <TextBlock Style="{StaticResource Kicker}" Foreground="{StaticResource Brush.InkSoft}" Margin="0,0,0,8" Text="{Binding PcbWaySummary, StringFormat='PCBWAY · {0}'}"/>
                  <TextBox Style="{StaticResource FieldInput}" Text="{Binding PcbWayKeyInput, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,16,0">
                  <Button Style="{StaticResource Btn}" Margin="0,0,6,0" Command="{Binding SavePcbWayKeyCommand}" Content="SAVE"/>
                  <Button Style="{StaticResource BtnGhost}" Command="{Binding RemovePcbWayKeyCommand}" Content="✕"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,8,0">
                  <TextBlock Style="{StaticResource Kicker}" Foreground="{StaticResource Brush.InkSoft}" Margin="0,0,0,8" Text="{Binding JlcpcbSummary, StringFormat='JLCPCB · {0}'}"/>
                  <TextBox Style="{StaticResource FieldInput}" Text="{Binding JlcpcbKeyInput, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Bottom">
                  <Button Style="{StaticResource Btn}" Margin="0,0,6,0" Command="{Binding SaveJlcpcbKeyCommand}" Content="SAVE"/>
                  <Button Style="{StaticResource BtnGhost}" Command="{Binding RemoveJlcpcbKeyCommand}" Content="✕"/>
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>

          <!-- OPTIONAL TOOLS -->
          <Border Style="{StaticResource Card}" Margin="0,18,0,0">
            <StackPanel>
              <Grid>
                <StackPanel Orientation="Horizontal">
                  <c:IconControl Glyph="download" IconSize="14" Stroke="{StaticResource Brush.InkMute}" VerticalAlignment="Center"
                                 ToolTip="Optional tools" AutomationProperties.Name="Optional tools"/>
                  <TextBlock Style="{StaticResource Serif}" FontSize="24" Margin="10,0,0,0" Text="Optional tools"/>
                </StackPanel>
                <Button Style="{StaticResource Btn}" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Command="{Binding InstallAllCommand}" Content="INSTALL ALL"
                        ToolTip="Download and install every missing tool" AutomationProperties.Name="Install all optional tools"/>
              </Grid>
              <TextBlock Style="{StaticResource Mono}" FontSize="10.5" Foreground="{StaticResource Brush.InkMute}" TextWrapping="Wrap" Margin="0,8,0,0"
                         Text="One-click installs to %LocalAppData%/Foundry/tools — no manual setup. You never need to install these yourself. KiCad installs per-user via the system package manager."/>

              <ItemsControl ItemsSource="{Binding OptionalTools}" Margin="0,8,0,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="{StaticResource Brush.Hairline}" BorderThickness="0,1,0,0" Padding="0,14,0,0" Margin="0,4,0,0">
                      <StackPanel>
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                          </Grid.ColumnDefinitions>
                          <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal">
                              <TextBlock FontFamily="{StaticResource Font.Mono}" FontSize="13" Foreground="{StaticResource Brush.Ink}" Text="{Binding Name}"/>
                              <TextBlock Style="{StaticResource Kicker}" Margin="10,0,0,0" VerticalAlignment="Center"
                                         Foreground="{StaticResource Brush.InkMute}" Text="{Binding StatusText}"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Mono}" FontSize="10.5" Foreground="{StaticResource Brush.InkMute}" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Text="{Binding Purpose}"/>
                          </StackPanel>
                          <Button Grid.Column="1" VerticalAlignment="Top" MinWidth="92"
                                  Command="{Binding InstallCommand}" Content="INSTALL"
                                  ToolTip="{Binding Name, StringFormat='Install {0}'}"
                                  AutomationProperties.Name="{Binding Name, StringFormat='Install {0}'}">
                            <Button.Style>
                              <Style TargetType="Button" BasedOn="{StaticResource Btn}">
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding Installed}" Value="True">
                                    <Setter Property="Content" Value="INSTALLED"/>
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </Button.Style>
                          </Button>
                        </Grid>
                        <StackPanel Visibility="{Binding Busy, Converter={StaticResource BoolVis}}" Margin="0,10,0,0">
                          <ProgressBar IsIndeterminate="True" Height="3" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Brush.Accent}"/>
                          <TextBlock Style="{StaticResource Mono}" FontSize="10.5" Foreground="{StaticResource Brush.InkMute}" Margin="0,6,0,0" Text="{Binding StatusLine}"/>
                        </StackPanel>
                        <TextBlock FontFamily="{StaticResource Font.Mono}" FontSize="10.5" Foreground="{StaticResource Brush.Fail}" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Text="{Binding StatusLine}">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock">
                              <Setter Property="Visibility" Value="{Binding StatusLine, Converter={StaticResource NullVis}}"/>
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding Busy}" Value="True">
                                  <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <!-- UPDATES -->
          <Border Style="{StaticResource Card}" Margin="0,18,0,0">
            <StackPanel>
              <Grid>
                <TextBlock Style="{StaticResource Serif}" FontSize="24" Text="Updates"/>
                <TextBlock Style="{StaticResource Kicker}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Accent}" Text="{Binding CurrentVersion}"/>
              </Grid>
              <Grid Margin="0,12,0,0">
                <TextBlock Style="{StaticResource Mono}" FontSize="11.5" Foreground="{StaticResource Brush.InkMute}" TextWrapping="Wrap" MaxWidth="520" HorizontalAlignment="Left"
                           Text="Checks GitHub Releases and downloads the signed installer. The release source is fixed to the official Foundry repo, and a downloaded update is only run if it's signed by Foundry's publisher."/>
                <Button Style="{StaticResource Btn}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Command="{Binding CheckUpdatesCommand}" Content="CHECK NOW"/>
              </Grid>
            </StackPanel>
          </Border>

          <!-- DIAGNOSTICS -->
          <Border Style="{StaticResource Card}" Margin="0,18,0,0">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Margin="0,0,16,0">
                <TextBlock Style="{StaticResource Serif}" FontSize="24" Text="Diagnostics"/>
                <TextBlock Style="{StaticResource Mono}" FontSize="11.5" Foreground="{StaticResource Brush.InkMute}" TextWrapping="Wrap" Margin="0,8,0,0"
                           Text="An audit trail of AI calls (model · sizes · duration · status), generation phases, and errors — for debugging. Also written to a daily log file."/>
                <TextBlock Style="{StaticResource Mono}" FontSize="10.5" Foreground="{StaticResource Brush.InkFaint}" TextWrapping="Wrap" Margin="0,8,0,0" Text="{Binding LogFolder}"/>
              </StackPanel>
              <Button Grid.Column="1" Style="{StaticResource Btn}" VerticalAlignment="Center" Command="{Binding ViewLogsCommand}" Content="VIEW LOGS"/>
            </Grid>
          </Border>

          <!-- SAVE -->
          <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
            <Button Style="{StaticResource BtnPrimary}" Command="{Binding SaveCommand}" Content="SAVE SETTINGS"/>
            <TextBlock VerticalAlignment="Center" Margin="14,0,0,0" FontFamily="{StaticResource Font.Mono}" FontSize="11" Foreground="{StaticResource Brush.Ok}" Text="{Binding SaveResult}"/>
          </StackPanel>

          <TextBlock Style="{StaticResource Kicker}" Margin="0,22,0,0" Foreground="{StaticResource Brush.InkFaint}" TextWrapping="Wrap"
                     Text="Keys are stored in Windows Credential Manager (DPAPI). Non-secret settings persist to %AppData%/Foundry/config.json. Network calls go only to Anthropic and the distributor APIs you configure."/>
        </StackPanel>
      </ScrollViewer>
    </DockPanel>
  </Border>
</UserControl>
