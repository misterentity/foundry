<UserControl x:Class="Foundry.App.Views.Tabs.WiringView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Foundry.App.Controls"
             xmlns:r="clr-namespace:Foundry.App.Rendering">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <!-- Content fills the window. This was MaxWidth=1280 + Center, so past ~1280 the page stopped
         growing and floated in dead space; Stretch is required because a Centered StackPanel with no
         MaxWidth sizes to its content instead of the available width. Prose blocks keep their own
         narrow MaxWidth further down - that is line-length for readability, not a layout cap. -->
    <StackPanel HorizontalAlignment="Stretch" Margin="32,28,32,60">

      <!-- PAGE HEAD -->
      <Grid Margin="0,0,0,16">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Style="{StaticResource Kicker}" Text="NETLIST → DIAGRAM · ORTHOGONAL LAYOUT · v3"/>
          <TextBlock Style="{StaticResource PageH1}" Margin="0,8,0,0" FontSize="44" LineHeight="52">
            <Run Text="How it "/><Run Text="connects." Foreground="{DynamicResource Brush.Accent}"/>
          </TextBlock>
          <TextBlock Style="{StaticResource Mono}" Foreground="{StaticResource Brush.InkSoft}" FontSize="13" TextWrapping="Wrap" MaxWidth="620" HorizontalAlignment="Left" Margin="0,16,0,0"
                     Text="The netlist is the source of truth — pin map, firmware, and enclosure cutouts all derive from these connections. Power runs red, ground gray, signal cyan."/>
        </StackPanel>
        <TextBlock Grid.Column="1" Style="{StaticResource Kicker}" Foreground="{StaticResource Brush.InkMute}" VerticalAlignment="Top" Margin="14,4,0,0"
                   Text="{Binding NetCount, StringFormat='{}{0} NETS'}"/>
      </Grid>

      <!-- ACTION BAR — wraps to available width so it can never overflow the layout (export + Track B PCB/fab).
           The headline action is DESIGN (DRC): the full build → route → DRC → remediate → retry loop. Single
           build+route (EXPORT + ROUTE PCB) and the rest are secondary affordances. -->
      <WrapPanel Margin="0,0,0,24">
        <Button Style="{StaticResource BtnPrimary}" Margin="0,0,8,8" Command="{Binding DesignPcbCommand}"
                ToolTip="Design a DRC-clean PCB: build → place → route → DRC, then remediate (looser clearance/more router passes) and retry until it passes or the iteration budget is spent — with per-iteration progress."
                AutomationProperties.Name="Design a DRC-clean PCB via the build, route and DRC fix loop">
          <StackPanel Orientation="Horizontal"><c:IconControl Glyph="bolt" IconSize="12" Stroke="{StaticResource Brush.OnAccent}" Margin="0,0,8,0"/><TextBlock Text="DESIGN PCB (DRC)"/></StackPanel>
        </Button>
        <Button Style="{StaticResource BtnGhost}" Margin="0,0,8,8" Command="{Binding DesignAndExportFabCommand}" Content="DESIGN + GERBERS"
                ToolTip="One-shot: build → place → route → DRC fix loop → Gerbers + drill ZIP from the netlist. Design aid — review the Gerbers in a viewer before ordering."
                AutomationProperties.Name="Design a DRC-clean PCB and export a fab ZIP in one action"/>
        <Button Style="{StaticResource BtnGhost}" Margin="0,0,8,8" Command="{Binding ExportFabCommand}" Content="EXPORT GERBERS"
                ToolTip="Export the standard 2-layer fab file set (Gerbers + Excellon drill) from the last DRC-clean board into a single ZIP. Design aid — review in a Gerber viewer before ordering."
                AutomationProperties.Name="Export Gerbers and drill as a fab ZIP from the last DRC-clean board"/>
        <Button Style="{StaticResource BtnGhost}" Margin="0,0,8,8" Command="{Binding ExportPcbCommand}" Content="EXPORT + ROUTE PCB"
                ToolTip="Single pass: build a KiCad PCB (.kicad_pcb) from the netlist — footprints, placement, ratsnest — then route copper tracks with FreeRouting (no DRC fix loop — use DESIGN PCB for that)"
                AutomationProperties.Name="Export to KiCad PCB and route in a single pass"/>
        <Button Style="{StaticResource BtnGhost}" Margin="0,0,8,8" Command="{Binding RoutePcbCommand}" Content="ROUTE"
                ToolTip="Route copper tracks on the last-built PCB with FreeRouting (export DSN → headless route → import SES)"
                AutomationProperties.Name="Route the last-built PCB"/>
        <Button Style="{StaticResource BtnGhost}" Margin="0,0,8,8" Command="{Binding ExportKiCadCommand}" Content="KICAD" ToolTip="Export a KiCad netlist (.net) + pinout CSV for PCB layout"
                AutomationProperties.Name="Export KiCad netlist"/>
        <Button Style="{StaticResource BtnGhost}" Margin="0,0,8,8" Command="{Binding ExportSvgCommand}" Content="SVG"/>
        <Button Style="{StaticResource BtnGhost}" Margin="0,0,0,8" Command="{Binding ExportPngCommand}" Content="EXPORT PNG"
                ToolTip="Render the wiring diagram (schematic or breadboard) to a PNG in the export folder"
                AutomationProperties.Name="Export the wiring diagram to PNG"/>
      </WrapPanel>

      <!-- PCB EXPORT STATUS (Track B) — mirrors the firmware VERIFY-BUILD status block -->
      <Border BorderBrush="{Binding PcbSeverity, Converter={StaticResource SevBrush}}" BorderThickness="1" Padding="16,12" Margin="0,0,0,20"
              Background="{StaticResource Brush.Surface1}" Visibility="{Binding HasPcbStatus, Converter={StaticResource BoolVis}}">
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <Rectangle Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,8,0" Fill="{Binding PcbSeverity, Converter={StaticResource SevBrush}}"/>
            <TextBlock Style="{StaticResource Mono}" FontSize="12.5" Foreground="{StaticResource Brush.Ink}" TextWrapping="Wrap" Text="{Binding PcbStatus}"/>
          </StackPanel>
          <ProgressBar IsIndeterminate="True" Height="3" Margin="0,10,0,0" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Brush.Accent}"
                       Visibility="{Binding IsExportingPcb, Converter={StaticResource BoolVis}}"/>
          <StackPanel Orientation="Horizontal" Margin="0,12,0,0" Visibility="{Binding HasFabZip, Converter={StaticResource BoolVis}}">
            <Button Style="{StaticResource BtnGhost}" Padding="12,5" FontSize="10" Margin="0,0,8,0"
                    Command="{Binding RevealFabZipCommand}" Content="REVEAL FAB ZIP"
                    ToolTip="Show the exported Gerber + drill ZIP in Explorer"
                    AutomationProperties.Name="Reveal the fab ZIP in Explorer"/>
            <Button Style="{StaticResource BtnGhost}" Padding="12,5" FontSize="10" Margin="0,0,8,0"
                    Command="{Binding QuoteFabCommand}" Content="QUOTE"
                    ToolTip="Get a price + lead-time quote for this board from the configured board house (clearly labelled Estimate vs Live — no order is placed)"
                    AutomationProperties.Name="Get a PCB quote from the board house"/>
            <Button Style="{StaticResource BtnPrimary}" Padding="12,5" FontSize="10"
                    Command="{Binding PlaceFabOrderCommand}" Content="ORDER PCB…"
                    ToolTip="Prepare the order: opens the board house's upload page with the params copied and the ZIP ready. Foundry never submits or pays — you place the order yourself on the fab's site."
                    AutomationProperties.Name="Prepare a PCB order with the board house"/>
          </StackPanel>
          <ItemsControl ItemsSource="{Binding PcbNotes}" Margin="0,10,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock FontFamily="{StaticResource Font.Mono}" FontSize="11" TextWrapping="Wrap" Margin="14,2,0,0"
                           Foreground="{StaticResource Brush.InkMute}" Text="{Binding}"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- FAB ORDER (Track B v2.7) — quote + assisted handoff; opt-in, user-keyed, explicit-confirm, never auto-orders -->
      <Border BorderBrush="{StaticResource Brush.Hairline2}" BorderThickness="1" Padding="16,12" Margin="0,0,0,20"
              Background="{StaticResource Brush.Surface1}" Visibility="{Binding HasFabOrderStatus, Converter={StaticResource BoolVis}}">
        <StackPanel>
          <Grid>
            <TextBlock Style="{StaticResource Kicker}" VerticalAlignment="Center" Text="{Binding FabProviderLabel, StringFormat='BOARD HOUSE · {0}'}"/>
            <TextBlock Style="{StaticResource Mono}" HorizontalAlignment="Right" FontSize="12.5" FontWeight="SemiBold"
                       Foreground="{DynamicResource Brush.Accent}" Text="{Binding FabQuoteText}"/>
          </Grid>
          <TextBlock Style="{StaticResource Mono}" FontSize="12.5" Foreground="{StaticResource Brush.Ink}" TextWrapping="Wrap" Margin="0,8,0,0" Text="{Binding FabOrderStatus}"/>
          <ProgressBar IsIndeterminate="True" Height="3" Margin="0,10,0,0" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Brush.Accent}"
                       Visibility="{Binding IsFabbing, Converter={StaticResource BoolVis}}"/>
          <ItemsControl ItemsSource="{Binding FabOrderNotes}" Margin="0,8,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock FontFamily="{StaticResource Font.Mono}" FontSize="11" TextWrapping="Wrap" Margin="14,2,0,0"
                           Foreground="{StaticResource Brush.InkMute}" Text="{Binding}"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Style="{StaticResource Mono}" FontSize="10.5" Foreground="{StaticResource Brush.InkFaint}" TextWrapping="Wrap" Margin="0,10,0,0"
                     Text="Foundry never submits an order and never pays — ORDER PCB only opens the fab's page with your params + ZIP ready so you can finish the order yourself."/>
        </StackPanel>
      </Border>

      <!-- VIEW TOGGLE + LIVE SIMULATION -->
      <Grid Margin="0,0,0,12">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Orientation="Horizontal">
          <Button Style="{StaticResource BtnGhost}" Padding="12,5" FontSize="10" Margin="0,0,6,0" Command="{Binding ShowSchematicCommand}" Content="SCHEMATIC"/>
          <Button Style="{StaticResource BtnGhost}" Padding="12,5" FontSize="10" Command="{Binding ShowBreadboardCommand}" Content="BREADBOARD"/>
        </StackPanel>

        <!-- live sim run control — drives the breadboard's live pin-state overlay -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" DataContext="{Binding Sim}">
          <Rectangle Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,8,0" Fill="{StaticResource Brush.Ok}"
                     Visibility="{Binding IsRunning, Converter={StaticResource BoolVis}}"/>
          <TextBlock Style="{StaticResource Mono}" FontSize="10.5" VerticalAlignment="Center" Margin="0,0,12,0" MaxWidth="420" HorizontalAlignment="Left" TextTrimming="CharacterEllipsis"
                     Foreground="{StaticResource Brush.InkMute}" Text="{Binding Status}"/>
          <ProgressBar IsIndeterminate="True" Width="60" Height="3" Margin="0,0,12,0" Background="Transparent" BorderThickness="0"
                       Foreground="{DynamicResource Brush.Accent}" Visibility="{Binding IsStarting, Converter={StaticResource BoolVis}}"/>
          <Button Style="{StaticResource BtnGhost}" Padding="12,5" FontSize="10" Margin="0,0,6,0" Command="{Binding InstallRenodeCommand}" Content="INSTALL RENODE"
                  ToolTip="Download a portable Renode emulator to run live simulation" AutomationProperties.Name="Install Renode"
                  Visibility="{Binding NeedsRenode, Converter={StaticResource BoolVis}}"/>
          <Button Style="{StaticResource BtnPrimary}" Padding="12,5" FontSize="10" Command="{Binding RunCommand}"
                  ToolTip="Compile and run the firmware in an emulator — pins light up live on the breadboard"
                  AutomationProperties.Name="Run simulation"
                  IsEnabled="{Binding CanSimulate}"
                  Visibility="{Binding IsRunning, Converter={StaticResource BoolVis}, ConverterParameter=invert}">
            <StackPanel Orientation="Horizontal"><c:IconControl Glyph="bolt" IconSize="11" Stroke="{StaticResource Brush.OnAccent}" Margin="0,0,6,0"/><TextBlock Text="RUN SIM"/></StackPanel>
          </Button>
          <Button Style="{StaticResource BtnGhost}" Padding="12,5" FontSize="10" Command="{Binding StopCommand}" Content="STOP" AutomationProperties.Name="Stop simulation"
                  Visibility="{Binding IsRunning, Converter={StaticResource BoolVis}}"/>
        </StackPanel>
      </Grid>

      <!-- WIRING STAGE -->
      <Border Background="{StaticResource Brush.Surface0}" BorderBrush="{StaticResource Brush.Hairline2}" BorderThickness="1" Padding="24" Margin="0,0,0,28">
        <!-- Both diagrams have a FIXED intrinsic width — WiringDiagramControl.MeasureOverride discards
             availableSize and lays out three columns, so it is ~950px for any project; BreadboardControl is
             similar. With DownOnly the Viewbox never scaled UP, so once the page stopped being capped at
             1280 the diagram sat marooned in the middle of the stage with ~500px of dead surface each side
             at 2560 — on the tab whose entire purpose is the diagram.
             Both controls render through OnRender(DrawingContext), i.e. pure vector, so scaling up is
             resolution-independent and costs no sharpness. MaxWidth stops it becoming absurd on an
             ultrawide, where a 3000px schematic would be worse than a centred one. -->
        <Grid>
          <Viewbox Stretch="Uniform" StretchDirection="Both" MaxWidth="1700" MaxHeight="1000"
                   Visibility="{Binding Breadboard, Converter={StaticResource BoolVis}, ConverterParameter=invert}">
            <r:WiringDiagramControl Project="{Binding Project}"/>
          </Viewbox>
          <Viewbox Stretch="Uniform" StretchDirection="Both" MaxWidth="1700" MaxHeight="1000"
                   Visibility="{Binding Breadboard, Converter={StaticResource BoolVis}}">
            <r:BreadboardControl Project="{Binding Project}" LivePinState="{Binding Sim.LivePinState}"/>
          </Viewbox>
        </Grid>
      </Border>

      <!-- LEGEND + LEDGER -->
      <Border BorderBrush="{StaticResource Brush.Hairline2}" BorderThickness="1">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

          <!-- legend -->
          <Border Grid.Column="0" BorderBrush="{StaticResource Brush.Hairline}" BorderThickness="0,0,1,0" Padding="18">
            <StackPanel>
              <TextBlock Style="{StaticResource Kicker}" Text="Legend"/>
              <WrapPanel Margin="0,12,0,0">
                <StackPanel Orientation="Horizontal" Margin="0,0,18,0"><Rectangle Width="24" Height="2" Fill="{StaticResource Brush.Power}" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBlock Style="{StaticResource Mono}" FontSize="10.5" Text="Power"/></StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,18,0"><Rectangle Width="24" Height="2" Fill="{StaticResource Brush.Ground}" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBlock Style="{StaticResource Mono}" FontSize="10.5" Text="Ground"/></StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,18,0"><Rectangle Width="24" Height="2" Fill="{StaticResource Brush.Signal}" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBlock Style="{StaticResource Mono}" FontSize="10.5" Text="Signal"/></StackPanel>
                <StackPanel Orientation="Horizontal"><Rectangle Width="24" Height="2" Fill="{StaticResource Brush.I2c}" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBlock Style="{StaticResource Mono}" FontSize="10.5" Text="I²C / Bus"/></StackPanel>
              </WrapPanel>
              <TextBlock Style="{StaticResource Kicker}" Margin="0,22,0,0" Text="Conventions"/>
              <StackPanel Margin="0,10,0,0">
                <TextBlock Style="{StaticResource Mono}" FontSize="12" Margin="0,2" Text="· Orthogonal routing · 4 mm pitch grid"/>
                <TextBlock Style="{StaticResource Mono}" FontSize="12" Margin="0,2" Text="· Pin labels are silkscreen-exact"/>
                <TextBlock Style="{StaticResource Mono}" FontSize="12" Margin="0,2" Text="· USB-C and antenna are off-board call-outs"/>
                <TextBlock Style="{StaticResource Mono}" FontSize="12" Margin="0,2" Text="· Junction = filled square · 5 × 6 px"/>
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- ledger -->
          <StackPanel Grid.Column="1">
            <Border BorderBrush="{StaticResource Brush.Hairline}" BorderThickness="0,0,0,1" Padding="18,16">
              <TextBlock Style="{StaticResource Kicker}" Text="{Binding NetCount, StringFormat='Connection ledger · {0} nets'}"/>
            </Border>
            <Grid>
              <TextBlock Style="{StaticResource Mono}" FontSize="12" Foreground="{StaticResource Brush.InkFaint}"
                         Margin="18,18" Text="No connections yet — the netlist drives every downstream stage."
                         Visibility="{Binding HasItems, ElementName=NetLedger, Converter={StaticResource BoolVis}, ConverterParameter=invert}"/>
              <ItemsControl x:Name="NetLedger" ItemsSource="{Binding Project.Connections}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="{StaticResource Brush.Hairline}" BorderThickness="0,0,0,1">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource Mono}" FontSize="11" Foreground="{StaticResource Brush.InkFaint}" Margin="14,12" Text="·"/>
                        <TextBlock Grid.Column="1" Style="{StaticResource Mono}" FontSize="11" Foreground="{StaticResource Brush.InkMute}" Margin="0,12" Text="{Binding From}"/>
                        <TextBlock Grid.Column="2" Style="{StaticResource Mono}" FontSize="11" Foreground="{StaticResource Brush.InkMute}" Margin="0,12" Text="{Binding To}"/>
                        <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="0,12">
                          <Rectangle Width="16" Height="2" VerticalAlignment="Center" Margin="0,0,8,0" Fill="{Binding Net, Converter={StaticResource NetBrush}}"/>
                          <TextBlock Style="{StaticResource Mono}" FontSize="11" Foreground="{Binding Net, Converter={StaticResource NetBrush}}" Text="{Binding Net}"/>
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Grid>
          </StackPanel>
        </Grid>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
