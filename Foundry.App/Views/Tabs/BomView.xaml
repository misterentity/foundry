<UserControl x:Class="Foundry.App.Views.Tabs.BomView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Foundry.App.Controls">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel MaxWidth="1280" HorizontalAlignment="Center" Margin="32,28,32,60">

      <!-- PAGE HEAD -->
      <Grid Margin="0,0,0,28">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Style="{StaticResource Kicker}" Text="{Binding LinesLabel}"/>
          <TextBlock Style="{StaticResource PageH1}" Margin="0,8,0,0" FontSize="44" LineHeight="52">
            <Run Text="What you'll "/><Run Text="buy." Foreground="{DynamicResource Brush.Accent}"/>
          </TextBlock>
          <!-- Was "Real-time pricing and availability per MPN" flat out. That is true only with a sourcing
               key configured; without one every figure below is generated, so the panel promised live data
               directly above a table of estimates. -->
          <TextBlock Style="{StaticResource Mono}" Foreground="{StaticResource Brush.InkSoft}" FontSize="13" TextWrapping="Wrap" MaxWidth="620" Margin="0,16,0,0"
                     Text="Prices start as estimates, marked EST. Add a sourcing key in Settings to fetch live pricing and stock per MPN — those rows re-tag as LIVE, and stock stays blank until a distributor actually answers. One-click cart links to DigiKey, Mouser, or Amazon. Substitute parts with chat ('swap the OLED for e-paper') and downstream stages re-run."/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,4">
          <TextBox Style="{StaticResource FieldInput}" Width="86" VerticalAlignment="Center" Margin="0,0,6,0" Padding="8,5"
                   Text="{Binding TargetBudget, UpdateSourceTrigger=PropertyChanged}" Tag="budget $"/>
          <Button Style="{StaticResource BtnGhost}" Margin="0,0,8,0" Command="{Binding OptimizeForBudgetCommand}" Content="HIT BUDGET" ToolTip="Substitute cheaper parts to come in under your target budget"/>
          <Button Style="{StaticResource BtnGhost}" Margin="0,0,8,0" Command="{Binding RefreshPricesCommand}">
            <StackPanel Orientation="Horizontal"><c:IconControl Glyph="refresh" IconSize="12" Margin="0,0,8,0"/><TextBlock Text="REFRESH PRICES"/></StackPanel>
          </Button>
          <Button Style="{StaticResource BtnGhost}" Margin="0,0,8,0" Command="{Binding CartMouserCommand}" Content="MOUSER BOM" ToolTip="Write a Mouser-format BOM CSV + open Mouser's BOM tool"/>
          <Button Style="{StaticResource BtnPrimary}" Command="{Binding CartCommand}" ToolTip="Write a DigiKey BOM CSV + open the DigiKey BOM manager">
            <StackPanel Orientation="Horizontal"><c:IconControl Glyph="cart" IconSize="12" Stroke="{StaticResource Brush.OnAccent}" Margin="0,0,8,0"/><TextBlock Text="{Binding TotalText, StringFormat='DIGIKEY · {0}'}"/></StackPanel>
          </Button>
        </StackPanel>
      </Grid>

      <!-- sourcing status -->
      <TextBlock Style="{StaticResource Kicker}" Margin="0,0,0,10" Foreground="{StaticResource Brush.InkMute}" Text="{Binding SourcingStatus}"/>

      <!-- BOM TABLE -->
      <!-- COMPONENT is the only elastic column, so with the chat panel open the fixed columns ate the whole
           row and the part NAME collapsed to about 20px: "Cap. Soil Moisture Sensor" rendered as "C:".
           The name is the one column nobody can work without. It gets a floor, and the table scrolls
           sideways past that point instead of crushing it. -->
      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,28">
      <Border BorderBrush="{StaticResource Brush.Hairline2}" BorderThickness="1">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

          <!-- header -->
          <Border Grid.Row="0" Background="{StaticResource Brush.Surface0}" BorderBrush="{StaticResource Brush.Hairline2}" BorderThickness="0,0,0,1">
            <Grid Margin="0">
              <Grid.ColumnDefinitions>
                <!-- UNIT carries the LIVE/EST provenance chip as well as the price, so it is wider than the
                     other money columns; MPN gives up the same width to keep COMPONENT's share unchanged. -->
                <ColumnDefinition Width="60"/><ColumnDefinition Width="*" MinWidth="220"/><ColumnDefinition Width="152"/>
                <ColumnDefinition Width="118"/><ColumnDefinition Width="80"/><ColumnDefinition Width="110"/>
                <ColumnDefinition Width="100"/><ColumnDefinition Width="80"/><ColumnDefinition Width="40"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Style="{StaticResource Kicker}" Margin="14,12" HorizontalAlignment="Right" Text="QTY"/>
              <TextBlock Grid.Column="1" Style="{StaticResource Kicker}" Margin="14,12" Text="COMPONENT"/>
              <TextBlock Grid.Column="2" Style="{StaticResource Kicker}" Margin="14,12" Text="MPN"/>
              <TextBlock Grid.Column="3" Style="{StaticResource Kicker}" Margin="14,12" HorizontalAlignment="Right" Text="UNIT"/>
              <TextBlock Grid.Column="4" Style="{StaticResource Kicker}" Margin="14,12" HorizontalAlignment="Right" Text="EXT."/>
              <TextBlock Grid.Column="5" Style="{StaticResource Kicker}" Margin="14,12" Text="STOCK"/>
              <TextBlock Grid.Column="6" Style="{StaticResource Kicker}" Margin="14,12" Text="DISTRIBUTOR"/>
              <TextBlock Grid.Column="7" Style="{StaticResource Kicker}" Margin="14,12" Text="LEAD"/>
            </Grid>
          </Border>

          <!-- empty state -->
          <TextBlock Grid.Row="1" Style="{StaticResource Mono}" FontSize="12" Foreground="{StaticResource Brush.InkFaint}"
                     Margin="14,18" Text="No parts yet — generate or revise the design to populate the BOM."
                     Visibility="{Binding HasItems, ElementName=BomRows, Converter={StaticResource BoolVis}, ConverterParameter=invert}"/>

          <!-- rows -->
          <ItemsControl x:Name="BomRows" Grid.Row="1" ItemsSource="{Binding Rows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border BorderBrush="{StaticResource Brush.Hairline}" BorderThickness="0,0,0,1">
                 <StackPanel>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="60"/><ColumnDefinition Width="*" MinWidth="220"/><ColumnDefinition Width="152"/>
                      <ColumnDefinition Width="118"/><ColumnDefinition Width="80"/><ColumnDefinition Width="110"/>
                      <ColumnDefinition Width="100"/><ColumnDefinition Width="80"/><ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource Mono}" Margin="14,12" HorizontalAlignment="Right" Text="{Binding Qty, StringFormat='{}{0}×'}"/>
                    <StackPanel Grid.Column="1" Margin="14,12">
                      <TextBlock Style="{StaticResource Mono}" Foreground="{StaticResource Brush.Ink}" Text="{Binding Name}"/>
                      <TextBlock Style="{StaticResource Mono}" FontSize="10.5" Foreground="{StaticResource Brush.InkFaint}" Margin="0,2,0,0" Text="{Binding Note}"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Style="{StaticResource Mono}" FontSize="11" Foreground="{StaticResource Brush.InkMute}" Margin="14,12" Text="{Binding Mpn}"/>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="14,12">
                      <!-- Price provenance was computed but never shown: an estimate and a real quote rendered identically. -->
                      <Border Background="{StaticResource Brush.Hairline2}" CornerRadius="2" Padding="3,1" Margin="0,0,6,0" VerticalAlignment="Center"
                              ToolTip="LIVE = fetched from a distributor. EST = generated estimate, not a quote.">
                        <TextBlock Style="{StaticResource Mono}" FontSize="9" Foreground="{StaticResource Brush.InkMute}" Text="{Binding PriceSourceTag}"/>
                      </Border>
                      <TextBlock Style="{StaticResource Mono}" Foreground="{StaticResource Brush.Ink}" Text="{Binding Price, StringFormat='${0:0.00}'}"/>
                    </StackPanel>
                    <TextBlock Grid.Column="4" Style="{StaticResource Mono}" Margin="14,12" HorizontalAlignment="Right" Foreground="{StaticResource Brush.Ink}" Text="{Binding Extended, StringFormat='${0:0.00}'}"/>
                    <StackPanel Grid.Column="5" Orientation="Horizontal" Margin="14,12">
                      <Rectangle Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,8,0" Fill="{Binding KnownStock, Converter={StaticResource StockBrush}}"/>
                      <TextBlock Style="{StaticResource Mono}" Foreground="{Binding KnownStock, Converter={StaticResource StockBrush}}" Text="{Binding StockText}"/>
                    </StackPanel>
                    <TextBlock Grid.Column="6" Style="{StaticResource Mono}" Foreground="{StaticResource Brush.Info}" Margin="14,12" Text="{Binding Dist}"/>
                    <TextBlock Grid.Column="7" Style="{StaticResource Mono}" Margin="14,12" Text="{Binding LeadText}"/>
                    <StackPanel Grid.Column="8" Orientation="Horizontal" Margin="4,8">
                      <Button Style="{StaticResource BtnGhost}" Padding="8,4" Margin="0,0,4,0" BorderBrush="{StaticResource Brush.Hairline2}" FontSize="10"
                              ToolTip="Suggest cheaper / in-stock substitutes" Content="ALT"
                              Command="{Binding DataContext.ToggleAlternatesCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                              CommandParameter="{Binding}"/>
                      <Button Style="{StaticResource BtnGhost}" Padding="8,4" BorderBrush="{StaticResource Brush.Hairline2}"
                              ToolTip="Open distributor search"
                              Command="{Binding DataContext.BuyCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                              CommandParameter="{Binding}">
                        <c:IconControl Glyph="chev" IconSize="10"/>
                      </Button>
                    </StackPanel>
                  </Grid>

                  <!-- substitutes (v2 G10) -->
                  <Border Visibility="{Binding ShowAlternates, Converter={StaticResource BoolVis}}" Background="{StaticResource Brush.Surface0}"
                          BorderBrush="{StaticResource Brush.Hairline}" BorderThickness="0,1,0,0" Padding="60,10,16,12">
                    <StackPanel>
                      <StackPanel Orientation="Horizontal" Visibility="{Binding AltBusy, Converter={StaticResource BoolVis}}">
                        <TextBlock Style="{StaticResource Mono}" FontSize="11" Foreground="{StaticResource Brush.InkMute}" Text="finding substitutes…"/>
                      </StackPanel>
                      <ItemsControl ItemsSource="{Binding Alternates}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Grid Margin="0,3">
                              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                              <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Style="{StaticResource Mono}" FontSize="11.5" Foreground="{StaticResource Brush.Ink}" Text="{Binding Name}"/>
                                <TextBlock Style="{StaticResource Mono}" FontSize="10" Foreground="{StaticResource Brush.InkFaint}" TextWrapping="Wrap" Text="{Binding Note}"/>
                              </StackPanel>
                              <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0" Style="{StaticResource Mono}" FontSize="11" Foreground="{StaticResource Brush.InkMute}" Text="{Binding PriceText}"/>
                              <Button Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource BtnGhost}" Padding="9,4" FontSize="10" Content="SWAP"
                                      Visibility="{Binding Mpn, Converter={StaticResource NullVis}}"
                                      Command="{Binding DataContext.SwapCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      CommandParameter="{Binding}"/>
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>
                 </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- footer -->
          <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Style="{StaticResource Kicker}" Margin="14,16" Text="{Binding SubtotalLabel}"/>
            <TextBlock Grid.Column="1" Style="{StaticResource Serif}" FontSize="28" Foreground="{DynamicResource Brush.Accent}" Margin="14,12" VerticalAlignment="Center" Text="{Binding TotalText}"/>
            <TextBlock Grid.Column="2" Style="{StaticResource Mono}" FontSize="11" Foreground="{StaticResource Brush.InkMute}" Margin="14,16" VerticalAlignment="Center" Text="+ shipping est. $4.99 · taxes excluded"/>
          </Grid>
        </Grid>
      </Border>
      </ScrollViewer>

      <!-- SOURCING SUMMARY (by distributor) -->
      <Border BorderBrush="{StaticResource Brush.Hairline2}" BorderThickness="1">
        <StackPanel>
          <Border BorderBrush="{StaticResource Brush.Hairline}" BorderThickness="0,0,0,1" Padding="16,14">
            <Grid>
              <TextBlock Style="{StaticResource Kicker}" Text="Sourcing summary · by distributor"/>
              <TextBlock Style="{StaticResource Kicker}" HorizontalAlignment="Right" Foreground="{StaticResource Brush.Warn}"
                         Text="{Binding LowStockCount, StringFormat='{}{0} low-stock'}"/>
            </Grid>
          </Border>
          <ItemsControl ItemsSource="{Binding ByDistributor}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border BorderBrush="{StaticResource Brush.Hairline}" BorderThickness="0,0,0,1">
                  <Grid Margin="16,12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="120"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource Mono}" FontSize="12" Foreground="{StaticResource Brush.Info}" Text="{Binding Distributor}"/>
                    <TextBlock Grid.Column="1" Style="{StaticResource Mono}" FontSize="11" Foreground="{StaticResource Brush.InkMute}" Margin="0,0,24,0" Text="{Binding LinesText}"/>
                    <TextBlock Grid.Column="2" Style="{StaticResource Mono}" FontSize="11" HorizontalAlignment="Right" Foreground="{Binding Status, Converter={StaticResource SevBrush}}" Text="{Binding StatusText}"/>
                    <TextBlock Grid.Column="3" Style="{StaticResource Mono}" FontSize="12" HorizontalAlignment="Right" Foreground="{StaticResource Brush.Ink}" Text="{Binding CostText}"/>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
