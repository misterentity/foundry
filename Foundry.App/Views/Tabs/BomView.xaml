<UserControl x:Class="Foundry.App.Views.Tabs.BomView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Foundry.App.Controls">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel MaxWidth="1280" HorizontalAlignment="Left" Margin="32,28,32,60">

      <!-- PAGE HEAD -->
      <Grid Margin="0,0,0,28">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Style="{StaticResource Kicker}" Text="BILL OF MATERIALS · 8 LINES · LIVE PRICING via NEXAR"/>
          <TextBlock Style="{StaticResource PageH1}" Margin="0,8,0,0" FontSize="60" LineHeight="68">
            <Run Text="What you'll "/><Run Text="buy." Foreground="{DynamicResource Brush.Accent}"/>
          </TextBlock>
          <TextBlock Style="{StaticResource Mono}" Foreground="{StaticResource Brush.InkSoft}" FontSize="13" TextWrapping="Wrap" MaxWidth="620" Margin="0,16,0,0"
                     Text="Real-time pricing and availability per MPN, with one-click cart links to DigiKey, Mouser, or Amazon. Substitute parts with chat ('swap the OLED for e-paper') and downstream stages re-run."/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,4">
          <Button Style="{StaticResource BtnGhost}" Margin="0,0,8,0">
            <StackPanel Orientation="Horizontal"><c:IconControl Glyph="refresh" IconSize="12" Margin="0,0,8,0"/><TextBlock Text="REFRESH PRICES"/></StackPanel>
          </Button>
          <Button Style="{StaticResource BtnPrimary}">
            <StackPanel Orientation="Horizontal"><c:IconControl Glyph="cart" IconSize="12" Stroke="{StaticResource Brush.OnAccent}" Margin="0,0,8,0"/><TextBlock Text="{Binding TotalText, StringFormat='CART · {0}'}"/></StackPanel>
          </Button>
        </StackPanel>
      </Grid>

      <!-- BOM TABLE -->
      <Border BorderBrush="{StaticResource Brush.Hairline2}" BorderThickness="1" Margin="0,0,0,28">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

          <!-- header -->
          <Border Grid.Row="0" Background="{StaticResource Brush.Surface0}" BorderBrush="{StaticResource Brush.Hairline2}" BorderThickness="0,0,0,1">
            <Grid Margin="0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="60"/><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/>
                <ColumnDefinition Width="80"/><ColumnDefinition Width="80"/><ColumnDefinition Width="110"/>
                <ColumnDefinition Width="100"/><ColumnDefinition Width="80"/><ColumnDefinition Width="40"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Style="{StaticResource Kicker}" Margin="14,12" HorizontalAlignment="Right" Text="QTY"/>
              <TextBlock Grid.Column="1" Style="{StaticResource Kicker}" Margin="14,12" Text="COMPONENT"/>
              <TextBlock Grid.Column="2" Style="{StaticResource Kicker}" Margin="14,12" Text="MPN"/>
              <TextBlock Grid.Column="3" Style="{StaticResource Kicker}" Margin="14,12" HorizontalAlignment="Right" Text="UNIT"/>
              <TextBlock Grid.Column="4" Style="{StaticResource Kicker}" Margin="14,12" HorizontalAlignment="Right" Text="EXT."/>
              <TextBlock Grid.Column="5" Style="{StaticResource Kicker}" Margin="14,12" Text="STOCK"/>
              <TextBlock Grid.Column="6" Style="{StaticResource Kicker}" Margin="14,12" Text="DISTRIBUTOR"/>
              <TextBlock Grid.Column="7" Style="{StaticResource Kicker}" Margin="14,12" Text="LEAD"/>
            </Grid>
          </Border>

          <!-- rows -->
          <ItemsControl Grid.Row="1" ItemsSource="{Binding Project.Bom}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border BorderBrush="{StaticResource Brush.Hairline}" BorderThickness="0,0,0,1">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="60"/><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/>
                      <ColumnDefinition Width="80"/><ColumnDefinition Width="80"/><ColumnDefinition Width="110"/>
                      <ColumnDefinition Width="100"/><ColumnDefinition Width="80"/><ColumnDefinition Width="40"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource Mono}" Margin="14,12" HorizontalAlignment="Right" Text="{Binding Qty, StringFormat='{}{0}×'}"/>
                    <StackPanel Grid.Column="1" Margin="14,12">
                      <TextBlock Style="{StaticResource Mono}" Foreground="{StaticResource Brush.Ink}" Text="{Binding Name}"/>
                      <TextBlock Style="{StaticResource Mono}" FontSize="10.5" Foreground="{StaticResource Brush.InkFaint}" Margin="0,2,0,0" Text="{Binding Note}"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Style="{StaticResource Mono}" FontSize="11" Foreground="{StaticResource Brush.InkMute}" Margin="14,12" Text="{Binding Mpn}"/>
                    <TextBlock Grid.Column="3" Style="{StaticResource Mono}" Margin="14,12" HorizontalAlignment="Right" Foreground="{StaticResource Brush.Ink}" Text="{Binding Price, StringFormat='${0:0.00}'}"/>
                    <TextBlock Grid.Column="4" Style="{StaticResource Mono}" Margin="14,12" HorizontalAlignment="Right" Foreground="{StaticResource Brush.Ink}" Text="{Binding Extended, StringFormat='${0:0.00}'}"/>
                    <StackPanel Grid.Column="5" Orientation="Horizontal" Margin="14,12">
                      <Rectangle Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,8,0" Fill="{Binding Stock, Converter={StaticResource StockBrush}}"/>
                      <TextBlock Style="{StaticResource Mono}" Foreground="{Binding Stock, Converter={StaticResource StockBrush}}" Text="{Binding Stock, StringFormat='{}{0:N0}'}"/>
                    </StackPanel>
                    <TextBlock Grid.Column="6" Style="{StaticResource Mono}" Foreground="{StaticResource Brush.Info}" Margin="14,12" Text="{Binding Dist}"/>
                    <TextBlock Grid.Column="7" Style="{StaticResource Mono}" Margin="14,12" Text="{Binding Lead}"/>
                    <Button Grid.Column="8" Style="{StaticResource BtnGhost}" Padding="8,4" Margin="4,8" BorderBrush="{StaticResource Brush.Hairline2}">
                      <c:IconControl Glyph="chev" IconSize="10"/>
                    </Button>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- footer -->
          <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Style="{StaticResource Kicker}" Margin="14,16" Text="{Binding SubtotalLabel}"/>
            <TextBlock Grid.Column="1" Style="{StaticResource Serif}" FontSize="28" Foreground="{DynamicResource Brush.Accent}" Margin="14,12" VerticalAlignment="Center" Text="{Binding TotalText}"/>
            <TextBlock Grid.Column="2" Style="{StaticResource Mono}" FontSize="11" Foreground="{StaticResource Brush.InkMute}" Margin="14,16" VerticalAlignment="Center" Text="+ shipping est. $4.99 · taxes excluded"/>
          </Grid>
        </Grid>
      </Border>

      <!-- SUBSTITUTIONS -->
      <Border BorderBrush="{StaticResource Brush.Hairline2}" BorderThickness="1">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border Grid.Column="0" BorderBrush="{StaticResource Brush.Hairline}" BorderThickness="0,0,1,0" Padding="16">
            <StackPanel>
              <TextBlock Style="{StaticResource Kicker}" Foreground="{StaticResource Brush.Warn}" Text="Substitute available"/>
              <TextBlock Style="{StaticResource Serif}" FontSize="18" Margin="0,6,0,4" Text="M12-GLAND → PG7-GLD"/>
              <TextBlock Style="{StaticResource Mono}" FontSize="11" Foreground="{StaticResource Brush.InkMute}" Text="+0.07 · in stock"/>
            </StackPanel>
          </Border>
          <Border Grid.Column="1" BorderBrush="{StaticResource Brush.Hairline}" BorderThickness="0,0,1,0" Padding="16">
            <StackPanel>
              <TextBlock Style="{StaticResource Kicker}" Foreground="{StaticResource Brush.Info}" Text="Bulk discount"/>
              <TextBlock Style="{StaticResource Serif}" FontSize="18" Margin="0,6,0,4" Text="TL3301AF260QG @ 25+"/>
              <TextBlock Style="{StaticResource Mono}" FontSize="11" Foreground="{StaticResource Brush.InkMute}" Text="−18% from Mouser"/>
            </StackPanel>
          </Border>
          <Border Grid.Column="2" Padding="16">
            <StackPanel>
              <TextBlock Style="{StaticResource Kicker}" Foreground="{StaticResource Brush.Info}" Text="Newer revision"/>
              <TextBlock Style="{StaticResource Serif}" FontSize="18" Margin="0,6,0,4" Text="TP4056 → IP5306 1A"/>
              <TextBlock Style="{StaticResource Mono}" FontSize="11" Foreground="{StaticResource Brush.InkMute}" Text="USB-C + boost"/>
            </StackPanel>
          </Border>
        </Grid>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
