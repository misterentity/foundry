<UserControl x:Class="Foundry.App.Views.Tabs.ValidationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Foundry.App.Controls">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel MaxWidth="1280" HorizontalAlignment="Left" Margin="32,28,32,60">

      <!-- PAGE HEAD -->
      <Grid Margin="0,0,0,28">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Style="{StaticResource Kicker}" Text="{Binding ChecksLabel}"/>
          <TextBlock Style="{StaticResource PageH1}" Margin="0,8,0,0" FontSize="60" LineHeight="68">
            <Run Text="Sanity "/><Run Text="check." Foreground="{DynamicResource Brush.Accent}"/>
          </TextBlock>
          <TextBlock Style="{StaticResource Mono}" Foreground="{StaticResource Brush.InkSoft}" FontSize="13" TextWrapping="Wrap" MaxWidth="620" Margin="0,16,0,0"
                     Text="Power budget, voltage/logic level mismatches, pin conflicts, I²C collisions — all evaluated deterministically against the assembled Project. AI never decides validation verdicts."/>
        </StackPanel>
        <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="0,0,0,4">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource BtnGhost}" Margin="0,0,8,0" Command="{Binding ExportReportCommand}">
              <StackPanel Orientation="Horizontal"><c:IconControl Glyph="download" IconSize="12" Margin="0,0,8,0"/><TextBlock Text="EXPORT REPORT"/></StackPanel>
            </Button>
            <Button Style="{StaticResource BtnPrimary}" Command="{Binding ReRunCommand}">
              <StackPanel Orientation="Horizontal"><c:IconControl Glyph="refresh" IconSize="12" Stroke="{StaticResource Brush.OnAccent}" Margin="0,0,8,0"/><TextBlock Text="RE-RUN CHECKS"/></StackPanel>
            </Button>
          </StackPanel>
          <TextBlock Style="{StaticResource Mono}" FontSize="11" Foreground="{StaticResource Brush.InkMute}" HorizontalAlignment="Right" Margin="0,8,0,0" TextWrapping="Wrap" MaxWidth="320" TextAlignment="Right" Text="{Binding Status}"/>
        </StackPanel>
      </Grid>

      <!-- SUMMARY STRIP -->
      <Border BorderBrush="{StaticResource Brush.Hairline2}" BorderThickness="1" Margin="0,0,0,28">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border Grid.Column="0" Background="{StaticResource Brush.FindWarnBg}" BorderBrush="{StaticResource Brush.Hairline}" BorderThickness="0,0,1,0" Padding="22">
            <StackPanel><TextBlock Style="{StaticResource Kicker}" Text="Status"/><TextBlock Style="{StaticResource Serif}" FontSize="42" Foreground="{StaticResource Brush.Warn}" Margin="0,6,0,0" Text="{Binding OverallStatus}"/></StackPanel>
          </Border>
          <Border Grid.Column="1" BorderBrush="{StaticResource Brush.Hairline}" BorderThickness="0,0,1,0" Padding="22">
            <StackPanel><TextBlock Style="{StaticResource Kicker}" Text="Failures"/><TextBlock Style="{StaticResource Serif}" FontSize="42" Foreground="{StaticResource Brush.Fail}" Margin="0,6,0,0" Text="{Binding FailCount}"/></StackPanel>
          </Border>
          <Border Grid.Column="2" BorderBrush="{StaticResource Brush.Hairline}" BorderThickness="0,0,1,0" Padding="22">
            <StackPanel><TextBlock Style="{StaticResource Kicker}" Text="Warnings"/><TextBlock Style="{StaticResource Serif}" FontSize="42" Foreground="{StaticResource Brush.Warn}" Margin="0,6,0,0" Text="{Binding WarnCount}"/></StackPanel>
          </Border>
          <Border Grid.Column="3" Padding="22">
            <StackPanel><TextBlock Style="{StaticResource Kicker}" Text="Passing"/><TextBlock Style="{StaticResource Serif}" FontSize="42" Foreground="{StaticResource Brush.Ok}" Margin="0,6,0,0" Text="{Binding PassText}"/></StackPanel>
          </Border>
        </Grid>
      </Border>

      <!-- FINDINGS -->
      <ItemsControl ItemsSource="{Binding Findings}" Margin="0,0,0,28">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border BorderBrush="{StaticResource Brush.Hairline2}" BorderThickness="1,1,1,0" Background="{StaticResource Brush.Surface0}">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{Binding Severity, Converter={StaticResource SevFindBg}}" BorderBrush="{StaticResource Brush.Hairline}" BorderThickness="0,0,1,0" Padding="14,16">
                  <StackPanel>
                    <TextBlock Style="{StaticResource Mono}" FontSize="10" Foreground="{Binding Severity, Converter={StaticResource SevBrush}}" Text="{Binding Severity}"/>
                    <TextBlock Style="{StaticResource Serif}" FontSize="22" Foreground="{Binding Severity, Converter={StaticResource SevBrush}}" Margin="0,6,0,0" Text="{Binding Num}"/>
                    <TextBlock Style="{StaticResource Mono}" FontSize="9" Foreground="{StaticResource Brush.InkFaint}" Text="{Binding Code}"/>
                  </StackPanel>
                </Border>

                <StackPanel Grid.Column="1" Margin="18,16">
                  <TextBlock Style="{StaticResource Serif}" FontSize="22" Text="{Binding Title}"/>
                  <TextBlock Style="{StaticResource Mono}" FontSize="12" Foreground="{StaticResource Brush.InkSoft}" TextWrapping="Wrap" MaxWidth="700" Margin="0,6,0,0" Text="{Binding Description}"/>
                  <ItemsControl ItemsSource="{Binding Refs}" Margin="0,10,0,0">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Style="{StaticResource Tag}" Margin="0,0,10,0"><TextBlock Style="{StaticResource TagText}" Text="{Binding}"/></Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>

                <Border Grid.Column="2" Background="{StaticResource Brush.Surface1}" BorderBrush="{StaticResource Brush.Hairline}" BorderThickness="1,0,0,0" Padding="18" MinWidth="200">
                  <StackPanel VerticalAlignment="Center">
                    <StackPanel Visibility="{Binding Fix, Converter={StaticResource NullVis}}">
                      <TextBlock Style="{StaticResource KickerAccent}" Text="Suggested fix"/>
                      <TextBlock Style="{StaticResource Serif}" FontSize="18" Margin="0,4" TextWrapping="Wrap" Text="{Binding Fix}"/>
                      <Button Style="{StaticResource BtnPrimary}" Padding="10,6" FontSize="10" HorizontalAlignment="Left" Content="APPLY &amp; RE-RUN"
                              Visibility="{Binding AutoFixable, Converter={StaticResource BoolVis}}"
                              Command="{Binding DataContext.ApplyFixCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                              CommandParameter="{Binding}"/>
                      <TextBlock Style="{StaticResource Mono}" FontSize="10" Foreground="{StaticResource Brush.InkMute}" TextWrapping="Wrap"
                                 Visibility="{Binding AutoFixable, Converter={StaticResource BoolVis}, ConverterParameter=invert}"
                                 Text="Apply manually, then RE-RUN CHECKS."/>
                    </StackPanel>
                    <TextBlock Visibility="{Binding Fix, Converter={StaticResource NullVis}, ConverterParameter=invert}"
                               Style="{StaticResource Mono}" FontSize="11" Foreground="{StaticResource Brush.Ok}" Text="✓ no action needed"/>
                  </StackPanel>
                </Border>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- POWER BUDGET -->
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <Border BorderBrush="{StaticResource Brush.Hairline}" BorderThickness="0,0,0,1" Padding="0,0,0,8" Margin="0,0,0,12">
            <Grid>
              <TextBlock Style="{StaticResource Kicker}" Foreground="{StaticResource Brush.InkSoft}" Text="POWER BUDGET · ACTIVE DRAW BY PART"/>
              <TextBlock Style="{StaticResource Kicker}" HorizontalAlignment="Right" Text="{Binding BatteryText}"/>
            </Grid>
          </Border>
          <Grid>
            <TextBlock Style="{StaticResource Kicker}" Text="{Binding PeakText}"/>
          </Grid>
          <Grid x:Name="PowerHost" Height="36" Margin="0,8,0,8"/>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
