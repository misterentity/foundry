<UserControl x:Class="Foundry.App.Views.Tabs.FirmwareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Foundry.App.Controls">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel MaxWidth="1280" HorizontalAlignment="Center" Margin="32,28,32,60">

      <!-- PAGE HEAD -->
      <Grid Margin="0,0,0,28">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Style="{StaticResource Kicker}" Text="{Binding HeaderText}"/>
          <TextBlock Style="{StaticResource PageH1}" Margin="0,8,0,0" FontSize="60" LineHeight="68">
            <Run Text="Code "/><Run Text="ready." Foreground="{DynamicResource Brush.Accent}"/>
          </TextBlock>
          <TextBlock Style="{StaticResource Mono}" Foreground="{StaticResource Brush.InkSoft}" FontSize="13" TextWrapping="Wrap" MaxWidth="620" Margin="0,16,0,0"
                     Text="Starter sketch with a pin map generated from the netlist — there are no hand-typed pins. Open the exported folder in PlatformIO or Arduino IDE 2.x and flash."/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,4">
          <Button Style="{StaticResource BtnGhost}" Margin="0,0,8,0" Command="{Binding VerifyBuildCommand}"
                  ToolTip="Compile the sketch with arduino-cli to prove it builds">
            <StackPanel Orientation="Horizontal"><c:IconControl Glyph="shield" IconSize="12" Margin="0,0,8,0"/><TextBlock Text="VERIFY BUILD"/></StackPanel>
          </Button>
          <Button Style="{StaticResource BtnGhost}" Margin="0,0,8,0" Command="{Binding ExportCommand}">
            <StackPanel Orientation="Horizontal"><c:IconControl Glyph="folder" IconSize="12" Margin="0,0,8,0"/><TextBlock Text="EXPORT FOLDER"/></StackPanel>
          </Button>
          <Button Style="{StaticResource BtnPrimary}" Command="{Binding CopyActiveCommand}">
            <StackPanel Orientation="Horizontal"><c:IconControl Glyph="download" IconSize="12" Stroke="{StaticResource Brush.OnAccent}" Margin="0,0,8,0"/><TextBlock Text="COPY FILE"/></StackPanel>
          </Button>
        </StackPanel>
      </Grid>

      <!-- BUILD VERIFICATION (v2 G1) -->
      <Border BorderBrush="{Binding BuildSeverity, Converter={StaticResource SevBrush}}" BorderThickness="1" Padding="16,12" Margin="0,0,0,20"
              Background="{StaticResource Brush.Surface1}" Visibility="{Binding HasBuildStatus, Converter={StaticResource BoolVis}}">
        <StackPanel>
          <Grid>
            <StackPanel Orientation="Horizontal">
              <Rectangle Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,8,0" Fill="{Binding BuildSeverity, Converter={StaticResource SevBrush}}"/>
              <TextBlock Style="{StaticResource Mono}" FontSize="12.5" Foreground="{StaticResource Brush.Ink}" TextWrapping="Wrap" Text="{Binding BuildStatus}"/>
            </StackPanel>
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
              <Button Style="{StaticResource BtnPrimary}" Padding="10,5" FontSize="10" Margin="0,0,8,0" Command="{Binding FixBuildCommand}" Content="FIX BUILD"
                      Visibility="{Binding CanFixBuild, Converter={StaticResource BoolVis}}"/>
              <Button Style="{StaticResource BtnGhost}" Padding="10,5" FontSize="10" Command="{Binding InstallToolchainCommand}" Content="INSTALL TOOLCHAIN"/>
            </StackPanel>
          </Grid>
          <ProgressBar IsIndeterminate="True" Height="3" Margin="0,10,0,0" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Brush.Accent}"
                       Visibility="{Binding IsBuilding, Converter={StaticResource BoolVis}}"/>
          <ItemsControl ItemsSource="{Binding BuildDiagnostics}" Margin="0,10,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock FontFamily="{StaticResource Font.Mono}" FontSize="11" TextWrapping="Wrap" Margin="14,2,0,0"
                           Foreground="{Binding Severity, Converter={StaticResource SevBrush}}"
                           Text="{Binding Display}"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- CODE PANE -->
      <Border BorderBrush="{StaticResource Brush.Hairline2}" BorderThickness="1" MinHeight="540" Margin="0,0,0,28">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

          <!-- file list -->
          <Border Grid.Column="0" Background="{StaticResource Brush.Surface0}" BorderBrush="{StaticResource Brush.Hairline}" BorderThickness="0,0,1,0">
            <StackPanel>
              <TextBlock Style="{StaticResource Kicker}" Margin="14,8" Text="Project files"/>
              <ListBox x:Name="FileList" ItemsSource="{Binding F.Files}" SelectedItem="{Binding ActiveFile, Mode=TwoWay}"
                       Background="Transparent" BorderThickness="0" SelectionChanged="FileList_SelectionChanged">
                <ListBox.ItemContainerStyle>
                  <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Template">
                      <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                          <Border x:Name="bd" Padding="14,8" BorderThickness="2,0,0,0" BorderBrush="Transparent">
                            <ContentPresenter/>
                          </Border>
                          <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                              <Setter TargetName="bd" Property="Background" Value="{StaticResource Brush.Surface1}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                              <Setter TargetName="bd" Property="Background" Value="{StaticResource Brush.Surface1}"/>
                              <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                            </Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Setter.Value>
                    </Setter>
                  </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <StackPanel>
                      <TextBlock Style="{StaticResource Mono}" FontSize="11.5" Foreground="{StaticResource Brush.InkSoft}" Text="{Binding Name}"/>
                      <TextBlock Style="{StaticResource Mono}" FontSize="10" Foreground="{StaticResource Brush.InkMute}" Text="{Binding Path}"/>
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>

              <TextBlock Style="{StaticResource Kicker}" Margin="14,16,14,8" Text="Libraries"/>
              <ItemsControl ItemsSource="{Binding F.Libraries}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Margin="14,4">
                      <TextBlock Style="{StaticResource Mono}" FontSize="11" Foreground="{StaticResource Brush.InkSoft}" Text="{Binding Key}"/>
                      <TextBlock Style="{StaticResource Mono}" FontSize="10" Foreground="{StaticResource Brush.InkMute}" Text="{Binding Value}"/>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <!-- code view -->
          <ScrollViewer Grid.Column="1" Background="{StaticResource Brush.CodeBg}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="0,18">
            <StackPanel x:Name="CodeHost"/>
          </ScrollViewer>
        </Grid>
      </Border>

      <!-- derived-artifact callout -->
      <Border BorderBrush="{StaticResource Brush.Hairline2}" BorderThickness="1" Background="{StaticResource Brush.AccentWash}" Padding="20,16">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <c:IconControl Grid.Column="0" Glyph="bolt" IconSize="20" Stroke="{DynamicResource Brush.Accent}" VerticalAlignment="Center"/>
          <StackPanel Grid.Column="1" Margin="18,0">
            <TextBlock Style="{StaticResource Serif}" FontSize="20"><Run Text="pinmap.h is a "/><Run Text="derived artifact" Foreground="{DynamicResource Brush.Accent}"/></TextBlock>
            <TextBlock Style="{StaticResource Mono}" FontSize="12" Foreground="{StaticResource Brush.InkMute}" Margin="0,4,0,0" Text="It re-generates on every wiring change. Edit the netlist, not the header."/>
          </StackPanel>
        </Grid>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
