<UserControl x:Class="Foundry.App.Views.Tabs.EnclosureView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Foundry.App.Controls"
             xmlns:r="clr-namespace:Foundry.App.Rendering"
             xmlns:h="clr-namespace:HelixToolkit.Wpf;assembly=HelixToolkit.Wpf">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel MaxWidth="1280" HorizontalAlignment="Left" Margin="32,28,32,60">

      <!-- PAGE HEAD -->
      <Grid Margin="0,0,0,28">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Style="{StaticResource Kicker}" Text="PARAMETRIC CAD · build123d · OpenCASCADE 7.7.2"/>
          <TextBlock Style="{StaticResource PageH1}" Margin="0,8,0,0" FontSize="60" LineHeight="68">
            <Run Text="What you'll "/><Run Text="print." Foreground="{DynamicResource Brush.Accent}"/>
          </TextBlock>
          <TextBlock Style="{StaticResource Mono}" Foreground="{StaticResource Brush.InkSoft}" FontSize="13" TextWrapping="Wrap" MaxWidth="620" Margin="0,16,0,0"
                     Text="A snap-lid enclosure sized from your component footprints. Cutouts and standoffs are derived directly from the components — ports always line up. Export as STL/3MF for slicing or STEP for manual editing."/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,4">
          <Button Style="{StaticResource BtnGhost}" Margin="0,0,8,0" Content="STEP"/>
          <Button Style="{StaticResource BtnGhost}" Margin="0,0,8,0" Content="3MF"/>
          <Button Style="{StaticResource BtnPrimary}">
            <StackPanel Orientation="Horizontal"><c:IconControl Glyph="download" IconSize="12" Stroke="{StaticResource Brush.OnAccent}" Margin="0,0,8,0"/><TextBlock Text="STL · 1.42 MB"/></StackPanel>
          </Button>
        </StackPanel>
      </Grid>

      <!-- GRID: preview + controls -->
      <Border BorderBrush="{StaticResource Brush.Hairline2}" BorderThickness="1">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

          <!-- preview -->
          <Border Grid.Column="0" BorderBrush="{StaticResource Brush.Hairline}" BorderThickness="0,0,1,0" Padding="32" MinHeight="520">
            <Border.Background>
              <RadialGradientBrush Center="0.6,0.5" GradientOrigin="0.6,0.5" RadiusX="0.7" RadiusY="0.8">
                <GradientStop Color="#FF1A1A22" Offset="0"/><GradientStop Color="#FF08080A" Offset="0.8"/>
              </RadialGradientBrush>
            </Border.Background>
            <Grid>
              <!-- iso schematic preview (shown until/if the real mesh loads) -->
              <Viewbox Stretch="Uniform" Visibility="{Binding MeshReady, Converter={StaticResource BoolVis}, ConverterParameter=invert}">
                <r:EnclosureIsoControl Width="720" Height="460"/>
              </Viewbox>

              <!-- live 3D mesh from the CAD sidecar -->
              <h:HelixViewport3D x:Name="Viewport" Background="Transparent"
                                 ShowViewCube="True" ShowCoordinateSystem="True" ShowFrameRate="False"
                                 ZoomExtentsWhenLoaded="True"
                                 Visibility="{Binding MeshReady, Converter={StaticResource BoolVis}}">
                <h:DefaultLights/>
                <ModelVisual3D x:Name="MeshHost"/>
              </h:HelixViewport3D>

              <!-- sidecar status badge -->
              <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14"
                      Background="{StaticResource Brush.Surface0}" BorderBrush="{StaticResource Brush.Hairline2}" BorderThickness="1" Padding="8,4">
                <StackPanel Orientation="Horizontal">
                  <Rectangle Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,6,0" Fill="{DynamicResource Brush.Accent}"/>
                  <TextBlock Style="{StaticResource Kicker}" FontSize="9.5" Text="{Binding SidecarStatus}"/>
                </StackPanel>
              </Border>

              <!-- view buttons -->
              <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" BorderBrush="{StaticResource Brush.Hairline2}" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                  <Button Style="{StaticResource Btn}" Padding="12,8" Content="ISO"/>
                  <Button Style="{StaticResource BtnGhost}" Padding="12,8" Content="FRONT"/>
                  <Button Style="{StaticResource BtnGhost}" Padding="12,8" Content="TOP"/>
                  <Button Style="{StaticResource BtnGhost}" Padding="12,8" Content="EXPLODED"/>
                </StackPanel>
              </Border>

              <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <Button Style="{StaticResource BtnGhost}" Padding="8,5" FontSize="10" Margin="0,0,0,4" Content="RESET CAM"/>
                <Button Style="{StaticResource BtnGhost}" Padding="8,5" FontSize="10" Margin="0,0,0,4" Content="ORTHO"/>
                <Button Style="{StaticResource BtnGhost}" Padding="8,5" FontSize="10" Content="MEASURE"/>
              </StackPanel>
            </Grid>
          </Border>

          <!-- controls -->
          <StackPanel Grid.Column="1" Margin="22">
            <TextBlock Style="{StaticResource Kicker}" Text="Dimensions · inner"/>
            <Border BorderBrush="{StaticResource Brush.Hairline2}" BorderThickness="1" Margin="0,8,0,18">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                <Border Grid.Row="0" Grid.Column="0" BorderBrush="{StaticResource Brush.Hairline}" BorderThickness="0,0,1,1" Padding="14,12">
                  <StackPanel><TextBlock Style="{StaticResource Kicker}" Text="Length"/><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Serif}" FontSize="24" Text="{Binding LengthText}"/><TextBlock Style="{StaticResource Mono}" FontSize="11" Foreground="{StaticResource Brush.InkMute}" VerticalAlignment="Bottom" Margin="4,0,0,3" Text="mm"/></StackPanel></StackPanel>
                </Border>
                <Border Grid.Row="0" Grid.Column="1" BorderBrush="{StaticResource Brush.Hairline}" BorderThickness="0,0,0,1" Padding="14,12">
                  <StackPanel><TextBlock Style="{StaticResource Kicker}" Text="Width"/><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Serif}" FontSize="24" Text="{Binding WidthText}"/><TextBlock Style="{StaticResource Mono}" FontSize="11" Foreground="{StaticResource Brush.InkMute}" VerticalAlignment="Bottom" Margin="4,0,0,3" Text="mm"/></StackPanel></StackPanel>
                </Border>
                <Border Grid.Row="1" Grid.Column="0" BorderBrush="{StaticResource Brush.Hairline}" BorderThickness="0,0,1,0" Padding="14,12">
                  <StackPanel><TextBlock Style="{StaticResource Kicker}" Text="Height"/><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Serif}" FontSize="24" Text="{Binding HeightText}"/><TextBlock Style="{StaticResource Mono}" FontSize="11" Foreground="{StaticResource Brush.InkMute}" VerticalAlignment="Bottom" Margin="4,0,0,3" Text="mm"/></StackPanel></StackPanel>
                </Border>
                <Border Grid.Row="1" Grid.Column="1" Padding="14,12">
                  <StackPanel><TextBlock Style="{StaticResource Kicker}" Text="Wall"/><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Serif}" FontSize="24" Text="{Binding WallText}"/><TextBlock Style="{StaticResource Mono}" FontSize="11" Foreground="{StaticResource Brush.InkMute}" VerticalAlignment="Bottom" Margin="4,0,0,3" Text="mm"/></StackPanel></StackPanel>
                </Border>
              </Grid>
            </Border>

            <TextBlock Style="{StaticResource Kicker}" Text="Cutouts · derived from footprints"/>
            <Border BorderBrush="{StaticResource Brush.Hairline2}" BorderThickness="1" Margin="0,8,0,18">
              <ItemsControl ItemsSource="{Binding E.Cutouts}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="{StaticResource Brush.Hairline}" BorderThickness="0,0,0,1">
                      <Grid Margin="12,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource Mono}" FontSize="11" Foreground="{DynamicResource Brush.Accent}" Text="{Binding Face}"/>
                        <TextBlock Grid.Column="1" Style="{StaticResource Mono}" FontSize="11" Foreground="{StaticResource Brush.Ink}" Text="{Binding Label}"/>
                        <TextBlock Grid.Column="2" Style="{StaticResource Mono}" FontSize="11" Foreground="{StaticResource Brush.InkMute}" Text="{Binding DimsText}"/>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Border>

            <TextBlock Style="{StaticResource Kicker}" Text="Print estimate · 0.2 mm PETG"/>
            <Border BorderBrush="{StaticResource Brush.Hairline2}" BorderThickness="1" Margin="0,8,0,18">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" BorderBrush="{StaticResource Brush.Hairline}" BorderThickness="0,0,1,0" Padding="14,12">
                  <StackPanel><TextBlock Style="{StaticResource Kicker}" Text="Mass"/><StackPanel Orientation="Horizontal" Margin="0,4,0,0"><TextBlock Style="{StaticResource Serif}" FontSize="32" Text="{Binding E.MassGrams}"/><TextBlock Style="{StaticResource Mono}" Foreground="{StaticResource Brush.InkMute}" VerticalAlignment="Bottom" Margin="4,0,0,4" Text="g"/></StackPanel></StackPanel>
                </Border>
                <Border Grid.Column="1" Padding="14,12">
                  <StackPanel><TextBlock Style="{StaticResource Kicker}" Text="Time"/><TextBlock Style="{StaticResource Serif}" FontSize="32" Margin="0,4,0,0" Text="{Binding E.PrintTime}"/></StackPanel>
                </Border>
              </Grid>
            </Border>

            <Button Style="{StaticResource BtnPrimary}" HorizontalAlignment="Stretch">
              <StackPanel Orientation="Horizontal"><c:IconControl Glyph="download" IconSize="12" Stroke="{StaticResource Brush.OnAccent}" Margin="0,0,8,0"/><TextBlock Text="EXPORT STL + 3MF + STEP"/></StackPanel>
            </Button>
          </StackPanel>
        </Grid>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
