<UserControl x:Class="Foundry.App.Views.Tabs.EnclosureView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Foundry.App.Controls"
             xmlns:r="clr-namespace:Foundry.App.Rendering"
             xmlns:h="clr-namespace:HelixToolkit.Wpf;assembly=HelixToolkit.Wpf">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel MaxWidth="1280" HorizontalAlignment="Left" Margin="32,28,32,60">

      <!-- PAGE HEAD -->
      <Grid Margin="0,0,0,28">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Style="{StaticResource Kicker}" Text="PARAMETRIC CAD · trimesh + manifold3d · base + lid"/>
          <TextBlock Style="{StaticResource PageH1}" Margin="0,8,0,0" FontSize="60" LineHeight="68">
            <Run Text="What you'll "/><Run Text="print." Foreground="{DynamicResource Brush.Accent}"/>
          </TextBlock>
          <TextBlock Style="{StaticResource Mono}" Foreground="{StaticResource Brush.InkSoft}" FontSize="13" TextWrapping="Wrap" MaxWidth="620" Margin="0,16,0,0"
                     Text="An enclosure sized from your component footprints. Cutouts and standoffs are derived directly from the components — ports always line up. Export as STL or 3MF for slicing (set the format in Settings)."/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,4">
          <Button Style="{StaticResource BtnGhost}" Margin="0,0,8,0" Command="{Binding ToggleAdvancedCommand}" Content="ADVANCED"
                  ToolTip="Switch to AI-written parametric OpenSCAD"
                  Visibility="{Binding Advanced, Converter={StaticResource BoolVis}, ConverterParameter=invert}"/>
          <Button Style="{StaticResource BtnGhost}" Margin="0,0,8,0" Command="{Binding ToggleAdvancedCommand}" Content="◀ SCHEMA"
                  ToolTip="Back to the fast deterministic schema build"
                  Visibility="{Binding Advanced, Converter={StaticResource BoolVis}}"/>
          <Button Style="{StaticResource BtnPrimary}" Command="{Binding ExportStlCommand}">
            <StackPanel Orientation="Horizontal"><c:IconControl Glyph="download" IconSize="12" Stroke="{StaticResource Brush.OnAccent}" Margin="0,0,8,0"/><TextBlock Text="{Binding ExportLabel}"/></StackPanel>
          </Button>
        </StackPanel>
      </Grid>

      <!-- ADVANCED (OpenSCAD) STATUS STRIP -->
      <Border BorderBrush="{StaticResource Brush.Hairline2}" BorderThickness="1" Padding="16,12" Margin="0,0,0,18"
              Visibility="{Binding Advanced, Converter={StaticResource BoolVis}}">
        <StackPanel>
          <Grid>
            <StackPanel Orientation="Horizontal">
              <Rectangle Style="{StaticResource PulseDot}" Margin="0,0,8,0"
                         Visibility="{Binding ScadBusy, Converter={StaticResource BoolVis}}"/>
              <Rectangle Width="6" Height="6" Fill="{DynamicResource Brush.Accent}" VerticalAlignment="Center" Margin="0,0,8,0"
                         Visibility="{Binding ScadBusy, Converter={StaticResource BoolVis}, ConverterParameter=invert}"/>
              <TextBlock Style="{StaticResource Mono}" FontSize="11.5" Foreground="{StaticResource Brush.Ink}" Text="ADVANCED · AI-written parametric OpenSCAD"/>
            </StackPanel>
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
              <Button Style="{StaticResource BtnGhost}" Padding="10,5" FontSize="10" Margin="0,0,6,0" Command="{Binding CancelScadCommand}" Content="CANCEL"
                      Visibility="{Binding ScadBusy, Converter={StaticResource BoolVis}}"/>
              <Button Style="{StaticResource BtnGhost}" Padding="10,5" FontSize="10" Margin="0,0,6,0" Command="{Binding InstallOpenScadCommand}" Content="INSTALL OPENSCAD"
                      Visibility="{Binding OpenScadInstalled, Converter={StaticResource BoolVis}, ConverterParameter=invert}"/>
              <Button Style="{StaticResource BtnGhost}" Padding="10,5" FontSize="10" Margin="0,0,6,0" Command="{Binding RenderScadCommand}" Content="BUILD"
                      Visibility="{Binding OpenScadInstalled, Converter={StaticResource BoolVis}}"/>
              <Button Style="{StaticResource BtnPrimary}" Padding="10,5" FontSize="10" Command="{Binding GenerateScadCommand}" Content="REGENERATE"
                      Visibility="{Binding OpenScadInstalled, Converter={StaticResource BoolVis}}"/>
            </StackPanel>
          </Grid>
          <TextBlock Style="{StaticResource Mono}" FontSize="10.5" Foreground="{StaticResource Brush.InkMute}" Margin="0,8,0,0" TextWrapping="Wrap" Text="{Binding ScadStatus}"/>
          <ProgressBar IsIndeterminate="True" Height="3" Margin="0,8,0,0" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Brush.Accent}"
                       Visibility="{Binding ScadBusy, Converter={StaticResource BoolVis}}"/>
          <!-- parametric sliders (Phase D) -->
          <ItemsControl ItemsSource="{Binding Parameters}" Margin="0,8,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,3">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Style="{StaticResource Mono}" FontSize="11" VerticalAlignment="Center" Foreground="{StaticResource Brush.InkSoft}" Text="{Binding DisplayName}"/>
                  <Slider Grid.Column="1" Minimum="{Binding Min}" Maximum="{Binding Max}" TickFrequency="{Binding Step}" IsSnapToTickEnabled="True"
                          Value="{Binding Value, Mode=TwoWay}" VerticalAlignment="Center" Margin="6,0"/>
                  <TextBlock Grid.Column="2" Style="{StaticResource Mono}" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{StaticResource Brush.Ink}" Text="{Binding ValueText}"/>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- SCAD error (compiler stderr) + AI fix (Phase D fix-loop) -->
          <Border Background="{StaticResource Brush.Surface0}" BorderBrush="{StaticResource Brush.Fail}" BorderThickness="1" Padding="10,8" Margin="0,10,0,0"
                  Visibility="{Binding HasScadError, Converter={StaticResource BoolVis}}">
            <StackPanel>
              <Grid>
                <TextBlock Style="{StaticResource Kicker}" Foreground="{StaticResource Brush.Fail}" Text="OPENSCAD ERROR"/>
                <Button HorizontalAlignment="Right" Style="{StaticResource BtnPrimary}" Padding="10,5" FontSize="10" Command="{Binding FixScadCommand}" Content="FIX WITH AI"/>
              </Grid>
              <TextBlock FontFamily="{StaticResource Font.Mono}" FontSize="10.5" Foreground="{StaticResource Brush.InkSoft}" TextWrapping="Wrap" Margin="0,6,0,0" MaxHeight="120" Text="{Binding ScadError}"/>
            </StackPanel>
          </Border>

          <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="180" Margin="0,8,0,0"
                        Visibility="{Binding Scad, Converter={StaticResource NullVis}}">
            <TextBox IsReadOnly="True" FontFamily="{StaticResource Font.Mono}" FontSize="10.5" Background="{StaticResource Brush.Surface1}"
                     BorderBrush="{StaticResource Brush.Hairline}" BorderThickness="1" Padding="10,8" TextWrapping="NoWrap" Text="{Binding Scad}"/>
          </ScrollViewer>
        </StackPanel>
      </Border>

      <!-- GRID: preview + controls -->
      <Border BorderBrush="{StaticResource Brush.Hairline2}" BorderThickness="1">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

          <!-- preview -->
          <Border Grid.Column="0" BorderBrush="{StaticResource Brush.Hairline}" BorderThickness="0,0,1,0" Padding="32" MinHeight="520">
            <Border.Background>
              <RadialGradientBrush Center="0.6,0.5" GradientOrigin="0.6,0.5" RadiusX="0.7" RadiusY="0.8">
                <GradientStop Color="#FF1A1A22" Offset="0"/><GradientStop Color="#FF08080A" Offset="0.8"/>
              </RadialGradientBrush>
            </Border.Background>
            <Grid>
              <!-- loading state -->
              <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                          Visibility="{Binding IsLoading, Converter={StaticResource BoolVis}}">
                <TextBlock Style="{StaticResource Serif}" FontSize="26" HorizontalAlignment="Center" Foreground="{StaticResource Brush.InkSoft}" Text="Rendering model…"/>
                <TextBlock Style="{StaticResource Mono}" FontSize="11" HorizontalAlignment="Center" Foreground="{StaticResource Brush.InkMute}" Margin="0,8,0,14" Text="building the 3D enclosure from your design"/>
                <ProgressBar IsIndeterminate="True" Width="200" Height="3" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Brush.Accent}"/>
              </StackPanel>

              <!-- offline / error state -->
              <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="360"
                          Visibility="{Binding ShowOffline, Converter={StaticResource BoolVis}}">
                <TextBlock Style="{StaticResource Serif}" FontSize="24" HorizontalAlignment="Center" Foreground="{StaticResource Brush.InkMute}" Text="3D preview unavailable"/>
                <TextBlock Style="{StaticResource Mono}" FontSize="11" HorizontalAlignment="Center" TextAlignment="Center" Foreground="{StaticResource Brush.InkFaint}" TextWrapping="Wrap" Margin="0,8,0,0"
                           Text="The CAD sidecar isn't running. Dimensions and cutouts (right) are still accurate, and EXPORT STL works once it's back."/>
              </StackPanel>

              <!-- live 3D mesh from the CAD sidecar -->
              <h:HelixViewport3D x:Name="Viewport" Background="Transparent"
                                 ShowViewCube="True" ShowCoordinateSystem="True" ShowFrameRate="False"
                                 ZoomExtentsWhenLoaded="True"
                                 Visibility="{Binding MeshReady, Converter={StaticResource BoolVis}}">
                <h:DefaultLights/>
                <ModelVisual3D x:Name="MeshHost"/>
              </h:HelixViewport3D>

              <!-- sidecar status badge -->
              <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14"
                      Background="{StaticResource Brush.Surface0}" BorderBrush="{StaticResource Brush.Hairline2}" BorderThickness="1" Padding="8,4">
                <StackPanel Orientation="Horizontal">
                  <Rectangle Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,6,0" Fill="{DynamicResource Brush.Accent}"/>
                  <TextBlock Style="{StaticResource Kicker}" FontSize="9.5" Text="{Binding SidecarStatus}"/>
                </StackPanel>
              </Border>

              <!-- the 3D viewport is interactive: drag to orbit, scroll to zoom, view-cube to orient -->
              <TextBlock HorizontalAlignment="Left" VerticalAlignment="Bottom" Style="{StaticResource Kicker}" FontSize="9"
                         Foreground="{StaticResource Brush.InkMute}" Text="DRAG TO ORBIT · SCROLL TO ZOOM"/>
            </Grid>
          </Border>

          <!-- controls -->
          <StackPanel Grid.Column="1" Margin="22">
            <TextBlock Style="{StaticResource Kicker}" Text="Dimensions · inner"/>
            <Border BorderBrush="{StaticResource Brush.Hairline2}" BorderThickness="1" Margin="0,8,0,18">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                <Border Grid.Row="0" Grid.Column="0" BorderBrush="{StaticResource Brush.Hairline}" BorderThickness="0,0,1,1" Padding="14,12">
                  <StackPanel><TextBlock Style="{StaticResource Kicker}" Text="Length"/><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Serif}" FontSize="24" Text="{Binding LengthText}"/><TextBlock Style="{StaticResource Mono}" FontSize="11" Foreground="{StaticResource Brush.InkMute}" VerticalAlignment="Bottom" Margin="4,0,0,3" Text="mm"/></StackPanel></StackPanel>
                </Border>
                <Border Grid.Row="0" Grid.Column="1" BorderBrush="{StaticResource Brush.Hairline}" BorderThickness="0,0,0,1" Padding="14,12">
                  <StackPanel><TextBlock Style="{StaticResource Kicker}" Text="Width"/><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Serif}" FontSize="24" Text="{Binding WidthText}"/><TextBlock Style="{StaticResource Mono}" FontSize="11" Foreground="{StaticResource Brush.InkMute}" VerticalAlignment="Bottom" Margin="4,0,0,3" Text="mm"/></StackPanel></StackPanel>
                </Border>
                <Border Grid.Row="1" Grid.Column="0" BorderBrush="{StaticResource Brush.Hairline}" BorderThickness="0,0,1,0" Padding="14,12">
                  <StackPanel><TextBlock Style="{StaticResource Kicker}" Text="Height"/><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Serif}" FontSize="24" Text="{Binding HeightText}"/><TextBlock Style="{StaticResource Mono}" FontSize="11" Foreground="{StaticResource Brush.InkMute}" VerticalAlignment="Bottom" Margin="4,0,0,3" Text="mm"/></StackPanel></StackPanel>
                </Border>
                <Border Grid.Row="1" Grid.Column="1" Padding="14,12">
                  <StackPanel><TextBlock Style="{StaticResource Kicker}" Text="Wall"/><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Serif}" FontSize="24" Text="{Binding WallText}"/><TextBlock Style="{StaticResource Mono}" FontSize="11" Foreground="{StaticResource Brush.InkMute}" VerticalAlignment="Bottom" Margin="4,0,0,3" Text="mm"/></StackPanel></StackPanel>
                </Border>
              </Grid>
            </Border>

            <TextBlock Style="{StaticResource Kicker}" Text="Cutouts · derived from footprints"/>
            <Border BorderBrush="{StaticResource Brush.Hairline2}" BorderThickness="1" Margin="0,8,0,18">
              <Grid>
                <TextBlock Style="{StaticResource Mono}" FontSize="11.5" Foreground="{StaticResource Brush.InkFaint}"
                           Margin="14,16" Text="No cutouts — sealed enclosure. Components with external interfaces will add ports automatically."
                           Visibility="{Binding HasItems, ElementName=CutoutList, Converter={StaticResource BoolVis}, ConverterParameter=invert}"/>
              <ItemsControl x:Name="CutoutList" ItemsSource="{Binding E.Cutouts}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="{StaticResource Brush.Hairline}" BorderThickness="0,0,0,1">
                      <Grid Margin="12,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource Mono}" FontSize="11" Foreground="{DynamicResource Brush.Accent}" Text="{Binding Face}"/>
                        <TextBlock Grid.Column="1" Style="{StaticResource Mono}" FontSize="11" Foreground="{StaticResource Brush.Ink}" Text="{Binding Label}"/>
                        <TextBlock Grid.Column="2" Style="{StaticResource Mono}" FontSize="11" Foreground="{StaticResource Brush.InkMute}" Text="{Binding DimsText}"/>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              </Grid>
            </Border>

            <TextBlock Style="{StaticResource Kicker}" Text="Build features"/>
            <Border BorderBrush="{StaticResource Brush.Hairline2}" BorderThickness="1" Margin="0,8,0,18">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                <Border Grid.Row="0" Grid.Column="0" BorderBrush="{StaticResource Brush.Hairline}" BorderThickness="0,0,1,1" Padding="14,10">
                  <StackPanel><TextBlock Style="{StaticResource Kicker}" Text="Lid"/><TextBlock Style="{StaticResource Mono}" FontSize="13" Foreground="{StaticResource Brush.Ink}" Margin="0,3,0,0" Text="{Binding LidText}"/></StackPanel>
                </Border>
                <Border Grid.Row="0" Grid.Column="1" BorderBrush="{StaticResource Brush.Hairline}" BorderThickness="0,0,0,1" Padding="14,10">
                  <StackPanel><TextBlock Style="{StaticResource Kicker}" Text="Mounting"/><TextBlock Style="{StaticResource Mono}" FontSize="13" Foreground="{StaticResource Brush.Ink}" Margin="0,3,0,0" Text="{Binding MountText}"/></StackPanel>
                </Border>
                <Border Grid.Row="1" Grid.Column="0" BorderBrush="{StaticResource Brush.Hairline}" BorderThickness="0,0,1,0" Padding="14,10">
                  <StackPanel><TextBlock Style="{StaticResource Kicker}" Text="Standoffs"/><TextBlock Style="{StaticResource Mono}" FontSize="13" Foreground="{StaticResource Brush.Ink}" Margin="0,3,0,0" Text="{Binding StandoffText}"/></StackPanel>
                </Border>
                <Border Grid.Row="1" Grid.Column="1" Padding="14,10">
                  <StackPanel><TextBlock Style="{StaticResource Kicker}" Text="Ventilation"/><TextBlock Style="{StaticResource Mono}" FontSize="13" Foreground="{StaticResource Brush.Ink}" Margin="0,3,0,0" Text="{Binding VentText}"/></StackPanel>
                </Border>
              </Grid>
            </Border>

            <TextBlock Style="{StaticResource Kicker}" Text="Print estimate · 0.2 mm PETG"/>
            <Border BorderBrush="{StaticResource Brush.Hairline2}" BorderThickness="1" Margin="0,8,0,18">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" BorderBrush="{StaticResource Brush.Hairline}" BorderThickness="0,0,1,0" Padding="14,12">
                  <StackPanel><TextBlock Style="{StaticResource Kicker}" Text="Mass"/><StackPanel Orientation="Horizontal" Margin="0,4,0,0"><TextBlock Style="{StaticResource Serif}" FontSize="32" Text="{Binding E.MassGrams}"/><TextBlock Style="{StaticResource Mono}" Foreground="{StaticResource Brush.InkMute}" VerticalAlignment="Bottom" Margin="4,0,0,4" Text="g"/></StackPanel></StackPanel>
                </Border>
                <Border Grid.Column="1" Padding="14,12">
                  <StackPanel><TextBlock Style="{StaticResource Kicker}" Text="Time"/><TextBlock Style="{StaticResource Serif}" FontSize="32" Margin="0,4,0,0" Text="{Binding E.PrintTime}"/></StackPanel>
                </Border>
              </Grid>
            </Border>

            <Button Style="{StaticResource BtnPrimary}" HorizontalAlignment="Stretch" Command="{Binding ExportStlCommand}">
              <StackPanel Orientation="Horizontal"><c:IconControl Glyph="download" IconSize="12" Stroke="{StaticResource Brush.OnAccent}" Margin="0,0,8,0"/><TextBlock Text="EXPORT STL"/></StackPanel>
            </Button>
          </StackPanel>
        </Grid>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
