<UserControl x:Class="Foundry.App.Views.Tabs.GuideView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Foundry.App.Controls">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <!-- Content fills the window. This was MaxWidth=1280 + Center, so past ~1280 the page stopped
         growing and floated in dead space; Stretch is required because a Centered StackPanel with no
         MaxWidth sizes to its content instead of the available width. Prose blocks keep their own
         narrow MaxWidth further down - that is line-length for readability, not a layout cap. -->
    <StackPanel HorizontalAlignment="Stretch" Margin="32,28,32,60">

      <!-- PAGE HEAD -->
      <Grid Margin="0,0,0,28">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Style="{StaticResource Kicker}" Text="{Binding StepsLabel}"/>
          <TextBlock Style="{StaticResource PageH1}" Margin="0,8,0,0" FontSize="44" LineHeight="52">
            <Run Text="How to "/><Run Text="build." Foreground="{DynamicResource Brush.Accent}"/>
          </TextBlock>
          <TextBlock Style="{StaticResource Mono}" Foreground="{StaticResource Brush.InkSoft}" FontSize="13" TextWrapping="Wrap" MaxWidth="620" HorizontalAlignment="Left" Margin="0,16,0,0"
                     Text="Each step references the components and nets it touches. Export to Markdown or PDF for the workshop bench."/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,4">
          <Button Style="{StaticResource BtnGhost}" Margin="0,0,8,0" Command="{Binding ExportMarkdownCommand}" Content="MARKDOWN"/>
          <Button Style="{StaticResource BtnPrimary}" Command="{Binding ExportPdfCommand}">
            <StackPanel Orientation="Horizontal"><c:IconControl Glyph="download" IconSize="12" Stroke="{StaticResource Brush.OnAccent}" Margin="0,0,8,0"/><TextBlock Text="EXPORT PDF"/></StackPanel>
          </Button>
        </StackPanel>
      </Grid>

      <!-- DISCLAIMER -->
      <Border BorderBrush="{StaticResource Brush.WarnBorder}" BorderThickness="1" Background="{StaticResource Brush.WarnWash}" Padding="18,14" Margin="0,0,0,28">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <c:IconControl Grid.Column="0" Glyph="shield" IconSize="20" Stroke="{StaticResource Brush.Warn}" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="1" Margin="16,0,0,0" TextWrapping="Wrap" FontFamily="{StaticResource Font.Mono}" FontSize="12.5" Foreground="{StaticResource Brush.Ink}">
            <Run Text="DESIGN AID  " Foreground="{StaticResource Brush.Warn}" FontWeight="SemiBold"/>
            <Run Text="Foundry's outputs are a starting point — not a manufacturable spec. Verify polarity, voltage, and your power supply before applying power. Always wear safety glasses when soldering."/>
          </TextBlock>
        </Grid>
      </Border>

      <!-- STEPS -->
      <ItemsControl ItemsSource="{Binding Project.Assembly}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border BorderBrush="{StaticResource Brush.Hairline}" BorderThickness="0,1,0,0" Padding="0,24">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource Serif}" FontSize="80" Foreground="{StaticResource Brush.InkFaint}"
                           Text="{Binding N, StringFormat='{}{0:00}'}" VerticalAlignment="Top"/>
                <StackPanel Grid.Column="1" Margin="24,0,0,0">
                  <TextBlock Style="{StaticResource Serif}" FontSize="30" Text="{Binding Title}"/>
                  <TextBlock Style="{StaticResource Mono}" FontSize="13" Foreground="{StaticResource Brush.InkSoft}" TextWrapping="Wrap" MaxWidth="700" HorizontalAlignment="Left" LineHeight="22" Margin="0,8,0,0" Text="{Binding Body}"/>
                  <ItemsControl ItemsSource="{Binding Chips}" Margin="0,14,0,0">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Style="{StaticResource Tag}" Margin="0,0,8,8"><TextBlock Style="{StaticResource TagText}" Text="{Binding}"/></Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

    </StackPanel>
  </ScrollViewer>
</UserControl>
