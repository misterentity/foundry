<UserControl x:Class="Foundry.App.Views.Tabs.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Foundry.App.Controls">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel MaxWidth="1280" HorizontalAlignment="Left" Margin="32,28,32,60">

      <!-- PAGE HEAD -->
      <Grid Margin="0,0,0,28">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Style="{StaticResource Kicker}">
            <TextBlock.Text>
              <MultiBinding StringFormat="{}{0} · UPDATED {1}">
                <Binding Path="Project.Id"/>
                <Binding Path="Project.Updated"/>
              </MultiBinding>
            </TextBlock.Text>
          </TextBlock>
          <TextBlock Style="{StaticResource PageH1}" Margin="0,8,0,0" FontSize="60" LineHeight="68"
                     Text="{Binding Project.Title}"/>
          <TextBlock Style="{StaticResource Mono}" Foreground="{StaticResource Brush.InkSoft}" FontSize="13"
                     TextWrapping="Wrap" MaxWidth="620" Margin="0,16,0,0" HorizontalAlignment="Left"
                     Text="{Binding Project.Prompt}"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,4">
          <Button Style="{StaticResource BtnGhost}" Margin="0,0,8,0" Command="{Binding RebuildCommand}" ToolTip="Regenerate the whole project from its prompt">
            <StackPanel Orientation="Horizontal">
              <c:IconControl Glyph="refresh" IconSize="12" Margin="0,0,8,0"/><TextBlock Text="REBUILD"/>
            </StackPanel>
          </Button>
          <Button Style="{StaticResource BtnGhost}" Margin="0,0,8,0" Command="{Binding ExportBundleCommand}" Content="BUNDLE" ToolTip="Export a shareable .foundryproj (project + firmware + BOM + netlist + guide)"/>
          <Button Style="{StaticResource BtnPrimary}" Command="{Binding ExportPdfCommand}">
            <StackPanel Orientation="Horizontal">
              <c:IconControl Glyph="download" IconSize="12" Stroke="{StaticResource Brush.OnAccent}" Margin="0,0,8,0"/><TextBlock Text="EXPORT PDF"/>
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>

      <!-- KPI STRIP -->
      <Border BorderBrush="{StaticResource Brush.Hairline2}" BorderThickness="1" Margin="0,0,0,28">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <Border Grid.Column="0" BorderBrush="{StaticResource Brush.Hairline}" BorderThickness="0,0,1,0" Padding="20,18">
            <StackPanel>
              <TextBlock Style="{StaticResource Kicker}" Text="COMPONENTS"/>
              <TextBlock Style="{StaticResource Serif}" FontSize="38" Foreground="{DynamicResource Brush.Accent}" Margin="0,6,0,0"
                         Text="{Binding Project.Kpis.Parts}"/>
              <TextBlock Style="{StaticResource Mono}" FontSize="10.5" Foreground="{StaticResource Brush.Ok}" Text="+0 from rev 02"/>
            </StackPanel>
          </Border>

          <Border Grid.Column="1" BorderBrush="{StaticResource Brush.Hairline}" BorderThickness="0,0,1,0" Padding="20,18">
            <StackPanel>
              <TextBlock Style="{StaticResource Kicker}" Text="PROJECT COST"/>
              <TextBlock Style="{StaticResource Serif}" FontSize="38" Foreground="{DynamicResource Brush.Accent}" Margin="0,6,0,0"
                         Text="{Binding CostText}"/>
              <TextBlock Style="{StaticResource Mono}" FontSize="10.5" Foreground="{StaticResource Brush.Ok}" Text="–$1.85 (gland swap)"/>
            </StackPanel>
          </Border>

          <Border Grid.Column="2" BorderBrush="{StaticResource Brush.Hairline}" BorderThickness="0,0,1,0" Padding="20,18">
            <StackPanel>
              <TextBlock Style="{StaticResource Kicker}" Text="BATTERY LIFE"/>
              <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <TextBlock Style="{StaticResource Serif}" FontSize="38" Foreground="{StaticResource Brush.Warn}" Text="{Binding Project.Kpis.BatteryDays}"/>
                <TextBlock Style="{StaticResource Mono}" Foreground="{StaticResource Brush.InkMute}" VerticalAlignment="Bottom" Margin="4,0,0,8" Text="d"/>
              </StackPanel>
              <TextBlock Style="{StaticResource Mono}" FontSize="10.5" Foreground="{StaticResource Brush.Fail}" Text="Below 60-day goal"/>
            </StackPanel>
          </Border>

          <Border Grid.Column="3" Padding="20,18">
            <StackPanel>
              <TextBlock Style="{StaticResource Kicker}" Text="PRINT MASS"/>
              <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <TextBlock Style="{StaticResource Serif}" FontSize="38" Foreground="{DynamicResource Brush.Accent}" Text="{Binding Project.Kpis.PrintGrams}"/>
                <TextBlock Style="{StaticResource Mono}" Foreground="{StaticResource Brush.InkMute}" VerticalAlignment="Bottom" Margin="4,0,0,8" Text="g"/>
              </StackPanel>
              <TextBlock Style="{StaticResource Mono}" FontSize="10.5" Foreground="{StaticResource Brush.Ok}" Text="2h 14m @ 0.2mm"/>
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <!-- ARCHITECTURE -->
      <StackPanel Margin="0,0,0,28">
        <Grid Margin="0,0,0,14">
          <Border BorderBrush="{StaticResource Brush.Hairline}" BorderThickness="0,0,0,1" Padding="0,0,0,8">
            <Grid>
              <TextBlock Style="{StaticResource SectionTitle}" Text="Architecture"/>
              <TextBlock Style="{StaticResource SectionSub}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Text="4 subsystems · 9 nets"/>
            </Grid>
          </Border>
        </Grid>

        <Border BorderBrush="{StaticResource Brush.Hairline2}" BorderThickness="1">
          <ItemsControl ItemsSource="{Binding Project.Subsystems}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border BorderBrush="{StaticResource Brush.Hairline}" BorderThickness="0,0,1,1" Padding="18">
                  <StackPanel>
                    <Grid>
                      <TextBlock Style="{StaticResource Kicker}" Text="{Binding Role}"/>
                      <TextBlock Style="{StaticResource Kicker}" HorizontalAlignment="Right" Text="{Binding Mpn}"/>
                    </Grid>
                    <TextBlock Style="{StaticResource Serif}" FontSize="24" Margin="0,8,0,0" Text="{Binding Name}"/>
                    <Border Background="{StaticResource Brush.Hairline2}" Height="1" Margin="0,8"/>
                    <ItemsControl ItemsSource="{Binding Specs}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Grid Margin="0,3">
                            <TextBlock Style="{StaticResource Mono}" FontSize="11" Foreground="{StaticResource Brush.InkFaint}" Text="{Binding Key}"/>
                            <TextBlock Style="{StaticResource Mono}" FontSize="11" Foreground="{StaticResource Brush.InkSoft}" HorizontalAlignment="Right" Text="{Binding Value}"/>
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>
      </StackPanel>

      <!-- VALIDATION + SOURCING 2-up -->
      <Border BorderBrush="{StaticResource Brush.Hairline2}" BorderThickness="1">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.2*"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <Border Grid.Column="0" BorderBrush="{StaticResource Brush.Hairline}" BorderThickness="0,0,1,0" Padding="22">
            <StackPanel>
              <Grid>
                <TextBlock Style="{StaticResource Serif}" FontSize="24" Text="Validation status"/>
                <Border Style="{StaticResource Tag}" Background="{StaticResource Brush.TagWarnBg}" BorderBrush="{StaticResource Brush.TagWarnBorder}" HorizontalAlignment="Right">
                  <TextBlock Style="{StaticResource TagText}" Foreground="{StaticResource Brush.Warn}" Text="2 warn · 1 info · 2 pass"/>
                </Border>
              </Grid>
              <ItemsControl ItemsSource="{Binding TopFindings}" Margin="0,16,0,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="{StaticResource Brush.Hairline}" BorderThickness="0,0,0,1" Padding="0,0,0,10" Margin="0,0,0,10">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto"/>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource Tag}" VerticalAlignment="Top"
                                Background="{Binding Severity, Converter={StaticResource SevTagBg}}"
                                BorderBrush="{Binding Severity, Converter={StaticResource SevTagBorder}}">
                          <TextBlock Style="{StaticResource TagText}" Foreground="{Binding Severity, Converter={StaticResource SevBrush}}" Text="{Binding Num}"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0">
                          <TextBlock Foreground="{StaticResource Brush.Ink}" FontSize="13" TextWrapping="Wrap" Text="{Binding Title}"/>
                          <TextBlock Foreground="{StaticResource Brush.InkMute}" FontSize="11" Margin="0,2,0,0" Text="{Binding Code}"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Style="{StaticResource Mono}" FontSize="10" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Accent}"
                                   Visibility="{Binding Fix, Converter={StaticResource NullVis}}" Text="{Binding Fix}"/>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <Border Grid.Column="1" Padding="22">
            <StackPanel>
              <Grid>
                <TextBlock Style="{StaticResource Serif}" FontSize="24" Text="Sourcing"/>
                <Border Style="{StaticResource Tag}" Background="{StaticResource Brush.Surface1}" HorizontalAlignment="Right">
                  <TextBlock Style="{StaticResource TagText}" Text="{Binding StockText}"/>
                </Border>
              </Grid>
              <ItemsControl ItemsSource="{Binding Sourcing}" Margin="0,16,0,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="{StaticResource Brush.Hairline}" BorderThickness="0,0,0,1" Padding="0,12">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                          <ColumnDefinition Width="Auto"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource Mono}" Foreground="{StaticResource Brush.Info}" Text="{Binding Distributor}"/>
                        <TextBlock Grid.Column="1" Style="{StaticResource Mono}" Foreground="{StaticResource Brush.InkMute}" Margin="16,0" Text="{Binding LinesText}"/>
                        <TextBlock Grid.Column="2" Style="{StaticResource Mono}" Foreground="{StaticResource Brush.Ink}" Margin="0,0,16,0" Text="{Binding CostText}"/>
                        <Border Grid.Column="3" Style="{StaticResource Tag}"
                                Background="{Binding Status, Converter={StaticResource SevTagBg}}"
                                BorderBrush="{Binding Status, Converter={StaticResource SevTagBorder}}">
                          <TextBlock Style="{StaticResource TagText}" FontSize="9" Foreground="{Binding Status, Converter={StaticResource SevBrush}}" Text="{Binding StatusText}"/>
                        </Border>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Button Style="{StaticResource BtnPrimary}" Margin="0,18,0,0" HorizontalAlignment="Stretch" Command="{Binding CartCommand}">
                <StackPanel Orientation="Horizontal">
                  <c:IconControl Glyph="cart" IconSize="12" Stroke="{StaticResource Brush.OnAccent}" Margin="0,0,8,0"/>
                  <TextBlock Text="ADD ALL TO DIGIKEY CART"/>
                </StackPanel>
              </Button>
            </StackPanel>
          </Border>
        </Grid>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
