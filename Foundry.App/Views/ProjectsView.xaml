<UserControl x:Class="Foundry.App.Views.ProjectsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Foundry.App.Controls">
  <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{StaticResource Brush.Bg}">
    <StackPanel>
      <!-- HERO -->
      <Border BorderBrush="{StaticResource Brush.Hairline}" BorderThickness="0,0,0,1" Padding="44,44,44,28">
        <StackPanel>
          <TextBlock Style="{StaticResource Kicker}" Text="Library · local-first"/>
          <TextBlock Style="{StaticResource Serif}" FontSize="84" Margin="0,12,0,0" LineHeight="92">
            <Run Text="Your "/><Run Text="foundry." Foreground="{DynamicResource Brush.Accent}" FontStyle="Italic"/>
          </TextBlock>
        </StackPanel>
      </Border>

      <!-- LAUNCH CARDS -->
      <StackPanel Margin="44,40,44,0">
        <TextBlock Style="{StaticResource Kicker}" Text="Start"/>
        <Border Margin="0,14,0,0" BorderBrush="{StaticResource Brush.Hairline2}" BorderThickness="1,1,0,0">
          <!-- New project (title → description → action, top-aligned single column) -->
          <Border Background="{StaticResource Brush.AccentWash}" BorderBrush="{StaticResource Brush.Hairline}" BorderThickness="0,0,1,1" Padding="28,26" Cursor="Hand">
            <Border.InputBindings><MouseBinding MouseAction="LeftClick" Command="{Binding NewCommand}"/></Border.InputBindings>
            <StackPanel HorizontalAlignment="Left">
              <TextBlock Style="{StaticResource Serif}" FontSize="40" LineHeight="46" TextWrapping="Wrap" Text="Describe a device."/>
              <TextBlock Style="{StaticResource Mono}" FontSize="13" Foreground="{StaticResource Brush.InkSoft}" TextWrapping="Wrap" Margin="0,12,0,0" MaxWidth="640" HorizontalAlignment="Left"
                         Text="One prompt → architecture, BOM, wiring, firmware, a printable enclosure, and validation. Requires your Anthropic key (add it in Settings)."/>
              <StackPanel Orientation="Horizontal" Margin="0,16,0,0" HorizontalAlignment="Left">
                <c:IconControl Glyph="plus" IconSize="12" Stroke="{DynamicResource Brush.Accent}" VerticalAlignment="Center"/>
                <TextBlock Style="{StaticResource KickerAccent}" Margin="8,0,0,0" Text="NEW PROJECT"/>
              </StackPanel>
            </StackPanel>
          </Border>
        </Border>
      </StackPanel>

      <!-- RECENT -->
      <StackPanel Margin="44,40,44,60">
        <Grid>
          <TextBlock Style="{StaticResource Kicker}" Text="Recent" VerticalAlignment="Center"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource BtnGhost}" Padding="10,5" FontSize="10" Margin="0,0,12,0" Command="{Binding ImportCommand}" Content="IMPORT BUNDLE" ToolTip="Import a shared .foundryproj"/>
            <TextBlock Style="{StaticResource Kicker}" VerticalAlignment="Center" Foreground="{StaticResource Brush.InkFaint}" Text="{Binding Recent.Count, StringFormat='{}{0} saved'}"/>
          </StackPanel>
        </Grid>

        <!-- empty state -->
        <Border Margin="0,14,0,0" BorderBrush="{StaticResource Brush.Hairline2}" BorderThickness="1" Padding="32" Background="{StaticResource Brush.Surface0}"
                Visibility="{Binding HasRecent, Converter={StaticResource BoolVis}, ConverterParameter=invert}">
          <StackPanel HorizontalAlignment="Center">
            <TextBlock Style="{StaticResource Serif}" FontSize="22" Foreground="{StaticResource Brush.InkMute}" HorizontalAlignment="Center" Text="No saved projects yet."/>
            <TextBlock Style="{StaticResource Mono}" FontSize="11.5" Foreground="{StaticResource Brush.InkFaint}" HorizontalAlignment="Center" Margin="0,6,0,0" Text="Projects you generate are saved here automatically."/>
          </StackPanel>
        </Border>

        <!-- saved projects -->
        <Border Margin="0,14,0,0" BorderBrush="{StaticResource Brush.Hairline2}" BorderThickness="1,1,1,0"
                Visibility="{Binding HasRecent, Converter={StaticResource BoolVis}}">
          <ItemsControl ItemsSource="{Binding Recent}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border BorderBrush="{StaticResource Brush.Hairline}" BorderThickness="0,0,0,1" Background="{StaticResource Brush.Surface0}" Cursor="Hand">
                  <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick"
                                  Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                  CommandParameter="{Binding Id}"/>
                  </Border.InputBindings>
                  <Grid Margin="20,16">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                      <TextBlock Style="{StaticResource Serif}" FontSize="20" Text="{Binding Title}"/>
                      <TextBlock Style="{StaticResource Mono}" FontSize="11" Foreground="{StaticResource Brush.InkMute}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" Text="{Binding Prompt}"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Style="{StaticResource Mono}" FontSize="11" Foreground="{StaticResource Brush.InkMute}" VerticalAlignment="Center" Margin="0,0,18,0" Text="{Binding Updated}"/>
                    <TextBlock Grid.Column="2" Style="{StaticResource Mono}" FontSize="11" Foreground="{StaticResource Brush.InkSoft}" VerticalAlignment="Center" Margin="0,0,18,0" Text="{Binding PartsText}"/>
                    <TextBlock Grid.Column="3" Style="{StaticResource Mono}" FontSize="11" VerticalAlignment="Center" Margin="0,0,18,0"
                               Foreground="{Binding Status, Converter={StaticResource SevBrush}}" Text="{Binding StatusText}"/>
                    <Button Grid.Column="4" Style="{StaticResource BtnGhost}" Padding="8,4" FontSize="10" VerticalAlignment="Center" Content="✕"
                            ToolTip="Delete project" AutomationProperties.Name="Delete project"
                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding Id}"/>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
