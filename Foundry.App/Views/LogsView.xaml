<UserControl x:Class="Foundry.App.Views.LogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Foundry.App.Controls">
  <Border Background="{StaticResource Brush.Bg}">
    <DockPanel>
      <!-- top bar -->
      <Border DockPanel.Dock="Top" Background="{StaticResource Brush.Surface0}" BorderBrush="{StaticResource Brush.Hairline}" BorderThickness="0,0,0,1" Height="38">
        <Grid>
          <Button HorizontalAlignment="Left" Command="{Binding BackCommand}" Background="Transparent" BorderThickness="0,0,1,0"
                  BorderBrush="{StaticResource Brush.Hairline}" Padding="18,0" Cursor="Hand">
            <StackPanel Orientation="Horizontal">
              <c:IconControl Glyph="chev" IconSize="10" Stroke="{StaticResource Brush.InkMute}"/>
              <TextBlock Style="{StaticResource Kicker}" Margin="6,0,0,0" Text="BACK TO SETTINGS"/>
            </StackPanel>
          </Button>
          <TextBlock Style="{StaticResource Kicker}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Brush.Ink}" Text="DIAGNOSTICS · LOG"/>
        </Grid>
      </Border>

      <!-- toolbar -->
      <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Brush.Hairline}" BorderThickness="0,0,0,1" Padding="32,14">
        <Grid>
          <StackPanel Orientation="Horizontal">
            <Button Style="{StaticResource BtnGhost}" Margin="0,0,8,0" Command="{Binding RefreshCommand}">
              <StackPanel Orientation="Horizontal"><c:IconControl Glyph="refresh" IconSize="11" Margin="0,0,8,0"/><TextBlock Text="REFRESH"/></StackPanel>
            </Button>
            <Button Style="{StaticResource BtnGhost}" Margin="0,0,8,0" Command="{Binding CopyCommand}" Content="COPY ALL"/>
            <Button Style="{StaticResource BtnGhost}" Margin="0,0,8,0" Command="{Binding OpenFolderCommand}" Content="OPEN LOG FOLDER"/>
            <Button Style="{StaticResource BtnGhost}" Command="{Binding ClearCommand}" Content="CLEAR"/>
          </StackPanel>
          <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="{StaticResource Font.Mono}" FontSize="10.5" Foreground="{StaticResource Brush.InkMute}" Text="{Binding Status}"/>
        </Grid>
      </Border>

      <!-- log list -->
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding Entries}" Margin="0,4,0,40">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border BorderBrush="{StaticResource Brush.Hairline}" BorderThickness="0,0,0,1" Padding="32,8">
                <StackPanel>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="78"/><ColumnDefinition Width="52"/><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" FontFamily="{StaticResource Font.Mono}" FontSize="11" Foreground="{StaticResource Brush.InkMute}" Text="{Binding TimeText}"/>
                    <TextBlock Grid.Column="1" FontFamily="{StaticResource Font.Mono}" FontSize="10" Foreground="{Binding Sev, Converter={StaticResource SevBrush}}" Text="{Binding Level}"/>
                    <TextBlock Grid.Column="2" FontFamily="{StaticResource Font.Mono}" FontSize="10.5" Foreground="{StaticResource Brush.Info}" Text="{Binding Category}"/>
                    <TextBlock Grid.Column="3" FontFamily="{StaticResource Font.Mono}" FontSize="11.5" Foreground="{StaticResource Brush.Ink}" TextWrapping="Wrap" Text="{Binding Message}"/>
                  </Grid>
                  <TextBlock FontFamily="{StaticResource Font.Mono}" FontSize="10.5" Foreground="{StaticResource Brush.InkFaint}" TextWrapping="Wrap" Margin="220,2,0,0"
                             Visibility="{Binding HasDetail, Converter={StaticResource BoolVis}}" Text="{Binding Detail}"/>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </DockPanel>
  </Border>
</UserControl>
