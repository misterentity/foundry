<!--
  FOUNDRY — design tokens
  Direct port of design-reference/foundry/styles.css :root. Colors are exposed as both
  Color.* (for gradients/animation) and Brush.* (for fills/strokes). color-mix() tints
  are precomputed to #AARRGGBB. Accent brushes are DynamicResource-able for runtime swap.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

  <!-- ============ surfaces ============ -->
  <Color x:Key="Color.Bg">#FF07070A</Color>
  <Color x:Key="Color.Surface0">#FF0C0C10</Color>
  <Color x:Key="Color.Surface1">#FF111116</Color>
  <Color x:Key="Color.Surface2">#FF16161C</Color>
  <Color x:Key="Color.Surface3">#FF1D1D24</Color>
  <Color x:Key="Color.Hairline">#FF22222B</Color>
  <Color x:Key="Color.Hairline2">#FF2C2C36</Color>
  <Color x:Key="Color.Hairline3">#FF3A3A46</Color>

  <!-- ============ text ============ -->
  <Color x:Key="Color.Ink">#FFEDEDEE</Color>
  <Color x:Key="Color.InkSoft">#FFB6B6BB</Color>
  <Color x:Key="Color.InkMute">#FF6A6A72</Color>
  <Color x:Key="Color.InkFaint">#FF44444C</Color>

  <!-- ============ accents ============ -->
  <Color x:Key="Color.Accent">#FFFF5A1F</Color>
  <Color x:Key="Color.Accent2">#FFFF8A5A</Color>
  <Color x:Key="Color.Ok">#FF4ADE80</Color>
  <Color x:Key="Color.Warn">#FFFBBF24</Color>
  <Color x:Key="Color.Fail">#FFEF4444</Color>
  <Color x:Key="Color.Info">#FF5DD2FF</Color>
  <!-- "the engine declined to judge" — deliberately OUTSIDE the ok/warn/fail ramp so an unproven
       check never reads as a mild warning, and violet rather than grey so it reads as unknown
       rather than disabled. -->
  <Color x:Key="Color.Unproven">#FFA78BFA</Color>
  <Color x:Key="Color.Power">#FFFF4040</Color>
  <Color x:Key="Color.Ground">#FF888888</Color>
  <Color x:Key="Color.Signal">#FF5DD2FF</Color>
  <Color x:Key="Color.I2c">#FFC084FC</Color>
  <Color x:Key="Color.Black">#FF000000</Color>

  <!-- ============ brushes ============ -->
  <SolidColorBrush x:Key="Brush.Bg" Color="{StaticResource Color.Bg}"/>
  <SolidColorBrush x:Key="Brush.Surface0" Color="{StaticResource Color.Surface0}"/>
  <SolidColorBrush x:Key="Brush.Surface1" Color="{StaticResource Color.Surface1}"/>
  <SolidColorBrush x:Key="Brush.Surface2" Color="{StaticResource Color.Surface2}"/>
  <SolidColorBrush x:Key="Brush.Surface3" Color="{StaticResource Color.Surface3}"/>
  <SolidColorBrush x:Key="Brush.Hairline" Color="{StaticResource Color.Hairline}"/>
  <SolidColorBrush x:Key="Brush.Hairline2" Color="{StaticResource Color.Hairline2}"/>
  <SolidColorBrush x:Key="Brush.Hairline3" Color="{StaticResource Color.Hairline3}"/>

  <SolidColorBrush x:Key="Brush.Ink" Color="{StaticResource Color.Ink}"/>
  <SolidColorBrush x:Key="Brush.InkSoft" Color="{StaticResource Color.InkSoft}"/>
  <SolidColorBrush x:Key="Brush.InkMute" Color="{StaticResource Color.InkMute}"/>
  <SolidColorBrush x:Key="Brush.InkFaint" Color="{StaticResource Color.InkFaint}"/>

  <!-- accent kept mutable so the prototype's accent tweak can swap it at runtime -->
  <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}"/>
  <SolidColorBrush x:Key="Brush.Accent2" Color="{StaticResource Color.Accent2}"/>
  <SolidColorBrush x:Key="Brush.Ok" Color="{StaticResource Color.Ok}"/>
  <SolidColorBrush x:Key="Brush.Warn" Color="{StaticResource Color.Warn}"/>
  <SolidColorBrush x:Key="Brush.Fail" Color="{StaticResource Color.Fail}"/>
  <SolidColorBrush x:Key="Brush.Info" Color="{StaticResource Color.Info}"/>
  <SolidColorBrush x:Key="Brush.Unproven" Color="{StaticResource Color.Unproven}"/>
  <SolidColorBrush x:Key="Brush.Power" Color="{StaticResource Color.Power}"/>
  <SolidColorBrush x:Key="Brush.Ground" Color="{StaticResource Color.Ground}"/>
  <SolidColorBrush x:Key="Brush.Signal" Color="{StaticResource Color.Signal}"/>
  <SolidColorBrush x:Key="Brush.I2c" Color="{StaticResource Color.I2c}"/>

  <!-- on-accent ink (CSS #160600) -->
  <SolidColorBrush x:Key="Brush.OnAccent" Color="#FF160600"/>

  <!-- precomputed color-mix tints (sev N% over transparent bg / 40-50% border) -->
  <SolidColorBrush x:Key="Brush.TagOkBg"     Color="#144ADE80"/>
  <SolidColorBrush x:Key="Brush.TagOkBorder" Color="#664ADE80"/>
  <SolidColorBrush x:Key="Brush.TagWarnBg"     Color="#14FBBF24"/>
  <SolidColorBrush x:Key="Brush.TagWarnBorder" Color="#66FBBF24"/>
  <SolidColorBrush x:Key="Brush.TagFailBg"     Color="#14EF4444"/>
  <SolidColorBrush x:Key="Brush.TagFailBorder" Color="#66EF4444"/>
  <SolidColorBrush x:Key="Brush.TagInfoBg"     Color="#145DD2FF"/>
  <SolidColorBrush x:Key="Brush.TagInfoBorder" Color="#665DD2FF"/>
  <SolidColorBrush x:Key="Brush.TagUnprovenBg"     Color="#14A78BFA"/>
  <SolidColorBrush x:Key="Brush.TagUnprovenBorder" Color="#66A78BFA"/>
  <SolidColorBrush x:Key="Brush.TagAccentBg"     Color="#1AFF5A1F"/>
  <SolidColorBrush x:Key="Brush.TagAccentBorder" Color="#80FF5A1F"/>

  <!-- finding strip backgrounds (~7-8% over surface) -->
  <SolidColorBrush x:Key="Brush.FindWarnBg" Color="#12FBBF24"/>
  <SolidColorBrush x:Key="Brush.FindFailBg" Color="#14EF4444"/>
  <SolidColorBrush x:Key="Brush.FindInfoBg" Color="#125DD2FF"/>
  <SolidColorBrush x:Key="Brush.FindPassBg" Color="#124ADE80"/>
  <SolidColorBrush x:Key="Brush.FindUnprovenBg" Color="#12A78BFA"/>

  <!-- accent 6% callout wash -->
  <SolidColorBrush x:Key="Brush.AccentWash" Color="#0FFF5A1F"/>
  <SolidColorBrush x:Key="Brush.WarnWash" Color="#0FFBBF24"/>
  <SolidColorBrush x:Key="Brush.WarnBorder" Color="#66FBBF24"/>

  <!-- code editor surface (#050507) -->
  <SolidColorBrush x:Key="Brush.CodeBg" Color="#FF050507"/>

  <!-- ============ window backdrop gradient (.win-wrap) ============ -->
  <RadialGradientBrush x:Key="Brush.WinWrap" GradientOrigin="0.2,0" Center="0.2,0" RadiusX="0.7" RadiusY="0.9">
    <GradientStop Color="#FF15151C" Offset="0"/>
    <GradientStop Color="#00000000" Offset="0.6"/>
  </RadialGradientBrush>

  <!-- ============ titlebar gradient ============ -->
  <LinearGradientBrush x:Key="Brush.Titlebar" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#FF0E0E12" Offset="0"/>
    <GradientStop Color="#FF07070A" Offset="1"/>
  </LinearGradientBrush>

  <!-- ============ blueprint grid (24px) — tiled behind the window ============ -->
  <DrawingBrush x:Key="Brush.BlueprintGrid" TileMode="Tile" Viewport="0,0,24,24"
                ViewportUnits="Absolute" Stretch="None">
    <DrawingBrush.Drawing>
      <GeometryDrawing>
        <GeometryDrawing.Geometry>
          <GeometryGroup>
            <LineGeometry StartPoint="0,0" EndPoint="24,0"/>
            <LineGeometry StartPoint="0,0" EndPoint="0,24"/>
          </GeometryGroup>
        </GeometryDrawing.Geometry>
        <GeometryDrawing.Pen>
          <Pen Thickness="1" Brush="#05FFFFFF"/>
        </GeometryDrawing.Pen>
      </GeometryDrawing>
    </DrawingBrush.Drawing>
  </DrawingBrush>

  <!-- ============ metrics ============ -->
  <sys:Double x:Key="Metric.RailW">212</sys:Double>
  <sys:Double x:Key="Metric.ChatW">360</sys:Double>
  <sys:Double x:Key="Metric.TitlebarH">36</sys:Double>
  <sys:Double x:Key="Metric.TabbarH">38</sys:Double>
  <sys:Double x:Key="Metric.StatusbarH">28</sys:Double>
  <GridLength x:Key="Metric.RailWGL">212</GridLength>
  <GridLength x:Key="Metric.ChatWGL">360</GridLength>

  <!-- ============ fonts (bundled) ============ -->
  <FontFamily x:Key="Font.Serif">pack://application:,,,/Themes/Fonts/#Instrument Serif</FontFamily>
  <FontFamily x:Key="Font.Mono">pack://application:,,,/Themes/Fonts/#JetBrains Mono</FontFamily>

</ResourceDictionary>
