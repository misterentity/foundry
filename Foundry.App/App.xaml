<Application x:Class="Foundry.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Foundry.App.Converters"
             xmlns:vm="clr-namespace:Foundry.App.ViewModels"
             xmlns:views="clr-namespace:Foundry.App.Views"
             xmlns:tabs="clr-namespace:Foundry.App.Views.Tabs">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Themes/Tokens.xaml"/>
        <ResourceDictionary Source="Themes/Controls.xaml"/>
      </ResourceDictionary.MergedDictionaries>

      <!-- ===== converters ===== -->
      <conv:NetBrushConverter x:Key="NetBrush"/>
      <conv:SeverityBrushConverter x:Key="SevBrush"/>
      <conv:SeverityTagBgConverter x:Key="SevTagBg"/>
      <conv:SeverityTagBorderConverter x:Key="SevTagBorder"/>
      <conv:SeverityFindingBgConverter x:Key="SevFindBg"/>
      <conv:BoolToVisibilityConverter x:Key="BoolVis"/>
      <conv:NullToVisibilityConverter x:Key="NullVis"/>
      <conv:EqualsConverter x:Key="Eq"/>
      <conv:ActiveTabBrushConverter x:Key="ActiveTabBrush"/>
      <conv:ActiveTabInkConverter x:Key="ActiveTabInk"/>
      <conv:StockBrushConverter x:Key="StockBrush"/>

      <!-- ===== VM → View mapping ===== -->
      <DataTemplate DataType="{x:Type vm:OnboardingViewModel}">
        <views:OnboardingView/>
      </DataTemplate>
      <DataTemplate DataType="{x:Type vm:ProjectsViewModel}">
        <views:ProjectsView/>
      </DataTemplate>
      <DataTemplate DataType="{x:Type vm:NewProjectViewModel}">
        <views:NewProjectView/>
      </DataTemplate>
      <DataTemplate DataType="{x:Type vm:ShellViewModel}">
        <views:ShellView/>
      </DataTemplate>
      <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
        <views:SettingsView/>
      </DataTemplate>

      <!-- workspace tab VM → tab view -->
      <DataTemplate DataType="{x:Type vm:OverviewViewModel}"><tabs:OverviewView/></DataTemplate>
      <DataTemplate DataType="{x:Type vm:BomViewModel}"><tabs:BomView/></DataTemplate>
      <DataTemplate DataType="{x:Type vm:WiringViewModel}"><tabs:WiringView/></DataTemplate>
      <DataTemplate DataType="{x:Type vm:EnclosureViewModel}"><tabs:EnclosureView/></DataTemplate>
      <DataTemplate DataType="{x:Type vm:FirmwareViewModel}"><tabs:FirmwareView/></DataTemplate>
      <DataTemplate DataType="{x:Type vm:ValidationViewModel}"><tabs:ValidationView/></DataTemplate>
      <DataTemplate DataType="{x:Type vm:GuideViewModel}"><tabs:GuideView/></DataTemplate>
    </ResourceDictionary>
  </Application.Resources>
</Application>
